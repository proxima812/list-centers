# и Claude, и человеку. Ниже игнорируется только то, что генерируется локально.

# локальные сессии дизайн-пикера impeccable, не артефакт проекта
.impeccable/live/sessions/
.impeccable/live/annotations/
.impeccable/hook.cache.json

# локальные handoff-заметки между агентами
.agents/collab/

