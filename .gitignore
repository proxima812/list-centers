.claude/settings.local.json

# локальный кеш wrangler/miniflare
.wrangler/

# рабочие артефакты браузерных MCP-инструментов
.playwright-mcp/

# бренд-кит: пересобирается из палитр командой `bun run brand-kit`
/brand-kit.html
/brand-kit.pdf

