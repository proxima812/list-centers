---
import { BackToTop, Container, Footer, Header, SEO } from "@/components";
import { getLocaleFromUrl, getOgLocale } from "@/i18n";

import "@/styles/tailwind.css";
import { cn } from "@/utils/libs/cn";

interface Props {
	title?: string;
	description?: string;
	type?: "article" | "website";
	ogImage?: string | URL;
	keywords?: string | string[];
	indexRobots?: boolean;
	datePublished?: string | Date;
	dateModified?: string | Date;
	canonicalURL?: string | URL;
	rssURL?: string | URL;
	centered?: boolean;
	classContainer?: string;
}

const {
	datePublished,
	dateModified,
	indexRobots,
	title,
	type,
	description,
	ogImage,
	keywords,
	canonicalURL,
	rssURL,
	centered,
	classContainer,
} = Astro.props as Props;

const locale = getLocaleFromUrl(Astro.url);
---

<html
	lang={locale}
	data-language={locale}
	class="scroll-smooth subpixel-antialiased transition-colors duration-300 ease-linear"
>
	<head>
		<link
			rel="preload"
			href="/fonts/tatarverse-sans.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<SEO
			title={title}
			description={description}
			indexRobots={indexRobots}
			ogImage={ogImage}
			type={type}
			keywords={keywords}
			canonicalURL={canonicalURL}
			rssURL={rssURL}
			datePublished={datePublished}
			dateModified={dateModified}
			locale={getOgLocale(locale)}
		/>
		{
			import.meta.env.DEV && (
				<script is:inline>
					{`if (typeof window !== "undefined" && "serviceWorker" in navigator) {
						window.addEventListener("load", async () => {
							const registrations = await navigator.serviceWorker.getRegistrations();
							await Promise.all(registrations.map((registration) => registration.unregister()));
							if ("caches" in window) {
								const cacheKeys = await caches.keys();
								await Promise.all(cacheKeys.map((key) => caches.delete(key)));
							}
						});
					}`}
				</script>
			)
		}
	</head>
	<body class="flex min-h-screen flex-col bg-background font-sans text-foreground transition-colors">
		<Header />
		<Container container class={cn("py-12 md:py-22", classContainer)}>
			<div class={cn("flex flex-col gap-12", centered ? "items-center" : null)}>
				<slot />
			</div>
		</Container>
		<Footer />
		<BackToTop />
	</body>
</html>
