---
import BackToTop from "@/components/navigation/BackToTop.astro";
import Container from "@/components/layout/Container.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SEO from "@/components/layout/SEO.astro";
import { getLocaleFromUrl, getOgLocale } from "@/i18n";
import YandexMetrika from "@/components/layout/YandexMetrika.astro";
import { config } from "@/config";
import { Font } from "astro:assets";

import "@/styles/tailwind.css";
import { cn } from "@/lib/cn";
import NewsAnons from "@/components/home/NewsAnons.astro";

interface Props {
	title?: string;
	description?: string;
	type?: "article" | "website";
	ogImage?: string | URL;
	keywords?: string | string[];
	indexRobots?: boolean;
	datePublished?: string | Date;
	dateModified?: string | Date;
	canonicalURL?: string | URL;
	rssURL?: string | URL;
	markdownURL?: string | URL;
	alternates?: Array<{
		hreflang: string;
		href: string | URL;
	}>;
	centered?: boolean;
	classContainer?: string;
}

const {
	datePublished,
	dateModified,
	indexRobots,
	title,
	type,
	description,
	ogImage,
	keywords,
	canonicalURL,
	rssURL,
	markdownURL,
	alternates,
	centered,
	classContainer,
} = Astro.props as Props;

const locale = getLocaleFromUrl(Astro.url);
const yandexMetrika = config.site.analytics.yandexMetrika;
