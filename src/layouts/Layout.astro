---
import BackToTop from "@/components/navigation/BackToTop.astro";
import Container from "@/components/layout/Container.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SEO from "@/components/layout/SEO.astro";
import { getLocaleFromUrl, getOgLocale } from "@/i18n";
import YandexMetrika from "@/components/layout/YandexMetrika.astro";
import { config } from "@/config";

import "@/styles/tailwind.css";
import { cn } from "@/utils/libs/cn";

interface Props {
	title?: string;
	description?: string;
	type?: "article" | "website";
	ogImage?: string | URL;
	keywords?: string | string[];
	indexRobots?: boolean;
	datePublished?: string | Date;
	dateModified?: string | Date;
	canonicalURL?: string | URL;
	rssURL?: string | URL;
	markdownURL?: string | URL;
	alternates?: Array<{
		hreflang: string;
		href: string | URL;
	}>;
	centered?: boolean;
	classContainer?: string;
}

const {
	datePublished,
	dateModified,
	indexRobots,
	title,
	type,
	description,
	ogImage,
	keywords,
	canonicalURL,
	rssURL,
	markdownURL,
	alternates,
	centered,
	classContainer,
} = Astro.props as Props;

const locale = getLocaleFromUrl(Astro.url);
const yandexMetrika = config.site.analytics.yandexMetrika;
---

<html
	lang={locale}
	data-language={locale}
	class="subpixel-antialiased transition-colors duration-300 ease-linear motion-safe:scroll-smooth"
>
	<head>
		{/* Запасной вариант без JS: фон тёмной темы зелёного пресета
		    (hsl(142 14% 6.6%), как в pwaSettings) — дефолт теперь тёмный. Тег объявлен ДО инлайн-скрипта намеренно: скрипт
		    находит его через querySelector и переписывает. Если объявить ниже,
		    на момент выполнения скрипта тега еще нет в DOM, и в <head>
		    оказываются два theme-color. */}
		<meta name="theme-color" content="#0e1310" />

		{/* Тема применяется до первой отрисовки — иначе на каждой навигации
		    будет вспышка светлой темы. Скрипт намеренно синхронный и лежит
		    выше любых стилей и разметки. Переключатель (ThemeToggle) только
		    пишет в localStorage и повторяет эти же две строки. */}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				// В Safari с «Блокировать все куки» само обращение к localStorage
				// бросает SecurityError — без try/catch скрипт умирал бы целиком
				// и атрибуты темы/акцента/моушена не выставлялись вовсе.
				const read = (key) => {
					try {
						return localStorage.getItem(key);
					} catch {
						return null;
					}
				};
				const theme = read("theme") ?? "dark";
				const accent = read("accent") ?? "default";
				const motion = read("motion") ?? "on";
				const dark =
					theme === "dark" ||
					(theme === "system" && matchMedia("(prefers-color-scheme: dark)").matches);

				root.dataset.theme = theme;
				root.dataset.accent = accent;
				root.dataset.motion = motion;
				root.classList.toggle("dark", dark);

				// Фон страницы зависит и от темы, и от акцента: каждый пресет
				// несет свою темную «бумагу». Поэтому цвет адресной строки
				// читается из вычисленного токена, а не из константы. Здесь, в
				// <head>, стилей может еще не быть — тогда добираем на
				// DOMContentLoaded. Дальше за тег отвечает appearance.ts.
				const syncThemeColor = () => {
					const background = getComputedStyle(root)
						.getPropertyValue("--color-background")
						.trim();
					if (!background) return;

					// Плагин PWA вставляет собственный theme-color из манифеста —
					// одно статическое значение, которое не знает ни про тему, ни
					// про акцент. Тег должен остаться ровно один, наш.
					const metas = document.querySelectorAll('meta[name="theme-color"]');
					for (let i = 1; i < metas.length; i += 1) metas[i].remove();

					let meta = metas[0];
					if (!meta) {
						meta = document.createElement("meta");
						meta.name = "theme-color";
						document.head.append(meta);
					}
					meta.content = background;
				};

				// Дважды: сейчас — чтобы адресная строка была верной до первой
				// отрисовки, и на DOMContentLoaded — когда <head> разобрана
				// целиком и стал виден тег от PWA.
				syncThemeColor();
				document.addEventListener("DOMContentLoaded", syncThemeColor, { once: true });
			})();
		</script>

		<link
			rel="preload"
			href="/fonts/tatarverse-sans.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<SEO
			title={title}
			description={description}
			indexRobots={indexRobots}
			ogImage={ogImage}
			type={type}
			keywords={keywords}
			canonicalURL={canonicalURL}
			rssURL={rssURL}
			markdownURL={markdownURL}
			alternates={alternates}
			datePublished={datePublished}
			dateModified={dateModified}
			locale={getOgLocale(locale)}
		/>
		{
			import.meta.env.DEV && (
				<script is:inline>
					{`if (typeof window !== "undefined" && "serviceWorker" in navigator) {
						window.addEventListener("load", async () => {
							const registrations = await navigator.serviceWorker.getRegistrations();
							await Promise.all(registrations.map((registration) => registration.unregister()));
							if ("caches" in window) {
								const cacheKeys = await caches.keys();
								await Promise.all(cacheKeys.map((key) => caches.delete(key)));
							}
						});
					}`}
				</script>
			)
		}
	</head>
	<body class="flex min-h-screen flex-col bg-background font-sans text-foreground transition-colors">
		<Header />
		<Container container class={cn("py-12 md:py-22", classContainer)}>
			<div class={cn("flex flex-col gap-12", centered ? "items-center" : null)}>
				<slot />
			</div>
		</Container>
		<Footer />
		<BackToTop />
		{
			yandexMetrika.enabled && yandexMetrika.counterId && (
				<YandexMetrika counterId={yandexMetrika.counterId} />
			)
		}
	</body>
</html>
