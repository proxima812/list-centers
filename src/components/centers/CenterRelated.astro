---
import CardItem from "@/components/ui/CardItem.astro";
import type { CenterEntry } from "@/lib/center/collection";
import { getCenterLinks } from "@/lib/center/links";
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	entries: CenterEntry[];
	routeIds: Map<string, string>;
}

const { title, entries, routeIds } = Astro.props as Props;
---

{
	entries.length > 0 && (
		<section class="flex flex-col gap-5">
			<h2 class="flex items-center gap-2 text-lg font-semibold text-foreground">
				<Icon name="mdi:compass-outline" class="h-5 w-5 text-muted-foreground" />
				{title}
			</h2>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 ">
				{entries.map((entry) => (
					<CardItem
						id={entry.id}
						routeId={routeIds.get(entry.id) ?? entry.id}
						title={entry.data.title}
						summary={entry.data.summary}
						type={entry.data.type}
						category={entry.data.category}
						location={entry.data.location}
						region={entry.data.location?.region}
						pubDate={entry.data.pubDate}
						links={getCenterLinks(entry.body, entry.data.source)}
					/>
				))}
			</div>
		</section>
	)
}
