---
/**
 * Страница каталога центров целиком — от <Layout> до сетки карточек.
 *
 * Русский и английский каталоги отличаются только тем, откуда берутся
 * карточки и есть ли у страницы RSS с markdown-двойником. Всё остальное —
 * заголовок, мета, ключевые слова, тулбар — было дословной копией в двух
 * роутах. Роуты теперь отвечают только за данные, разметка живёт здесь.
 */
import ListCards from "@/components/centers/ListCards.astro";
import ListHeroTitle from "@/components/centers/ListHeroTitle.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
	cards: CollectionEntry<"centers" | "centersEn">[];
	/** Только у русской страницы: RSS и markdown-двойник существуют лишь по-русски. */
	rssURL?: string;
	markdownURL?: string;
}

const { cards, rssURL, markdownURL } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Цифры остались только в мете: сама плитка переехала на /stats.
// Считаем их по русской коллекции — она единственный источник географии.
const sourceCenters = await getCollection("centers");
const countriesCount = new Set(
	sourceCenters.map((card) => card.data.location?.country).filter(Boolean),
).size;
const regionsCount = new Set(
	sourceCenters.map((card) => card.data.location?.region).filter(Boolean),
).size;
const seoStats = {
	count: sourceCenters.length,
	countries: countriesCount,
	regions: regionsCount,
};
---

<Layout
	title={t("list.title")}
	description={t("list.description", seoStats)}
	rssURL={rssURL}
	markdownURL={markdownURL}
	keywords={[
		"ТБК",
		"татары",
		"башкиры",
		"крымские татары",
		`${sourceCenters.length} карточек ТБК`,
		`стран: ${countriesCount}`,
		`регионов: ${regionsCount}`,
		"все страны",
		"все регионы",
		"поиск татарских центров",
		"фильтр культурных центров",
		"татарская диаспора",
		"башкирская диаспора",
		"крымскотатарская диаспора",
	]}
>
	<ListHeroTitle />
	<ListCards cards={cards} />
</Layout>
