---
import ListCards from "@/components/centers/ListCards.astro";
import ListHeroTitle from "@/components/centers/ListHeroTitle.astro";
import { catalogStats } from "@/domain/center/stats";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
	cards: CollectionEntry<"centers" | "centersEn">[];
	rssURL?: string;
	markdownURL?: string;
}

const { cards, rssURL, markdownURL } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const seoStats = catalogStats(await getCollection("centers"));
---

<Layout
	title={t("list.title")}
	description={t("list.description", seoStats)}
	rssURL={rssURL}
	markdownURL={markdownURL}
	keywords={[
		"ТБК",
		"татары",
		"башкиры",
		"крымские татары",
		`${seoStats.count} карточек ТБК`,
		`стран: ${seoStats.countries}`,
		`регионов: ${seoStats.regions}`,
		"все страны",
		"все регионы",
		"поиск татарских центров",
		"фильтр культурных центров",
		"татарская диаспора",
		"башкирская диаспора",
		"крымскотатарская диаспора",
	]}
>
	<ListHeroTitle />
	<ListCards cards={cards} />
</Layout>
