---
import type { CenterFacets } from "@/utils/centerFacets";
import FilterSection from "./FilterSection.astro";
import ScopeSwitch from "./ScopeSwitch.astro";

// Панель фильтров — дерево, а не четыре равноправных списка.
//
// Порядок секций сверху вниз повторяет вложенность: scope решает ветку,
// округ или макрорегион сужает её до десятка строк, дальше страна, регион и
// город. Категория стоит последней, потому что она единственная ортогональна
// географии и не участвует в дереве.
//
// `gate` — условие показа секции, его проверяет клиент:
//   ru        — только когда выбрана Россия;
//   world     — когда Россия не выбрана;
//   country   — когда выбрана корзина мира или scope «Зарубеж»;
//   region    — регион виден, когда выбрана ровно одна страна или Россия;
//   city      — город виден, когда выбран ровно один регион или одна страна.
// Именно `city`/`region` и склеивают уровни: выбрал Украину — под ней остался
// Киев, выбрал Пермский край — под ним Пермь, Лысьва, Березники.

interface Props {
	facets: CenterFacets;
}

const { facets } = Astro.props as Props;

const GATES: Record<string, string> = {
	macro: "world",
	okrug: "ru",
	country: "country",
	region: "region",
	city: "city",
	category: "always",
};
---

<aside
	data-filters-shell
	class="hidden w-full pb-8 lg:sticky lg:top-36 lg:block lg:max-h-[calc(100vh-10rem)] lg:overflow-y-auto lg:pb-12"
>
	<section class="w-full">
		{/*
			Панель — своя поверхность, а не голая колонка на фоне каталога:
			без заголовков групп у столбца фильтров не осталось ничего, что
			очерчивало бы его границы.
		*/}
		<div
			id="filters-panel"
			data-filters-panel
			class="hidden w-full space-y-4 rounded-catalog corner-squircle bg-surface p-4 text-surface-foreground"
		>
			<ScopeSwitch scopes={facets.scopes} total={facets.total} />

			{
				facets.facets.map((facet) => (
					<FilterSection facet={facet} gate={GATES[facet.key] ?? "always"} />
				))
			}
		</div>
	</section>
</aside>
<style>
	@media (min-width: 1024px) {
		[data-filters-shell],
		[data-filters-panel] {
			display: block !important;
		}
	}

	/* Панель по-прежнему скроллится, но полосу не рисуем: в узком aside
	   она отъедала ширину у строк фильтров и мигала при наведении. */
	[data-filters-shell] {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	[data-filters-shell]::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}
</style>

<script>
	import { initCardsToolbar } from "@/scripts/centersToolbar";

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCardsToolbar, { once: true });
	} else {
		initCardsToolbar();
	}
</script>
