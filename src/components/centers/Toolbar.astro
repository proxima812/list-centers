---
import type { CenterFacets } from "@/lib/center/facets";
import FilterSection from "./FilterSection.astro";
import ScopeSwitch from "./ScopeSwitch.astro";


interface Props {
	facets: CenterFacets;
}

const { facets } = Astro.props as Props;

const GATES: Record<string, string> = {
	macro: "world",
	okrug: "ru",
	country: "country",
	region: "region",
	city: "city",
	category: "always",
};
---

<aside
	data-filters-shell
	class="hidden w-full pb-8 lg:sticky lg:top-36 lg:block lg:max-h-[calc(100vh-10rem)] lg:overflow-y-auto lg:pb-12"
>
	<section class="w-full">
		<div
			id="filters-panel"
			data-filters-panel
			class="hidden w-full space-y-4 rounded-catalog corner-squircle bg-surface p-4 text-surface-foreground"
		>
			<ScopeSwitch scopes={facets.scopes} total={facets.total} />

			{
				facets.facets.map((facet) => (
					<FilterSection facet={facet} gate={GATES[facet.key] ?? "always"} />
				))
			}
		</div>
	</section>
</aside>

<script>
	import { initCardsToolbar } from "@/scripts/centersToolbar";

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCardsToolbar, { once: true });
	} else {
		initCardsToolbar();
	}
</script>
