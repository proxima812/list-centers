---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { Icon } from "astro-icon/components";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<form
	data-search-form
	role="search"
	class="relative z-40 flex items-center gap-1 rounded-catalog corner-squircle bg-surface p-1 shadow-2xs has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent"
>
	<label class="relative z-50 min-w-0 flex-1" for="centers-search">
		<span class="sr-only">{t("list.search.placeholder")}</span>
		<input
			id="centers-search"
			data-toolbar-search
			type="search"
			placeholder={t("list.search.placeholder")}
			aria-label={t("list.search.placeholder")}
			aria-controls="cards-grid"
			aria-autocomplete="list"
			aria-expanded="false"
			aria-haspopup="listbox"
			aria-owns="search-suggestions"
			autocomplete="off"
			class="min-h-11 w-full bg-transparent px-2 pr-11 text-sm text-surface-foreground outline-none placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden"
		/>
		<button
			type="button"
			data-search-clear
			aria-label={t("list.clearSearch")}
			hidden
			class="absolute right-0 top-1/2 grid size-11 -translate-y-1/2 cursor-pointer place-content-center rounded-full text-subtle-foreground transition hover:bg-muted hover:text-foreground"
		>
			<Icon name="mdi:close" class="size-4" aria-hidden="true" />
		</button>
	</label>

	<button
		type="button"
		data-filters-toggle
		aria-label={t("list.filters")}
		aria-expanded="false"
		aria-controls="filters-panel"
		class="relative grid size-11 shrink-0 place-items-center rounded-full bg-muted text-muted-foreground transition hover:bg-subtle lg:hidden"
	>
		<Icon name="mdi:tune" class="size-4" aria-hidden="true" />
		<span
			data-filters-badge
			class="absolute -right-1 -top-1 hidden min-w-4 rounded-full bg-accent px-1 text-center text-xs font-semibold tabular-nums text-accent-foreground"
		></span>
	</button>

	<button
		type="submit"
		data-search-submit
		aria-label={t("list.submitSearch")}
		disabled
		class="grid size-11 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground transition enabled:cursor-pointer enabled:hover:bg-depth-700 enabled:active:scale-95 disabled:cursor-not-allowed disabled:bg-muted disabled:text-depth-300"
	>
		<Icon name="mdi:arrow-up" class="size-5" aria-hidden="true" />
	</button>

	<ul
		id="search-suggestions"
		data-search-suggestions
		role="listbox"
		class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-40 hidden max-h-80 overflow-y-auto rounded-control corner-squircle bg-surface p-1.5 text-sm overlay-lift"
	>
	</ul>
</form>
