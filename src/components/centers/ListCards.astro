---
import { buildCenterFacets, buildFacetRecords, buildGeoIndex } from "@/utils/centerFacets";
import { getLocaleFromUrl } from "@/i18n";
import { getCollection, type CollectionEntry } from "astro:content";
import NoResults from "../ui/NoResults.astro";
import ActiveFilters from "./ActiveFilters.astro";
import GridCards from "./GridCards.astro";
import Search from "./Search.astro";
import Toolbar from "./Toolbar.astro";

interface Props {
	cards: CollectionEntry<"centers" | "centersEn">[];
}

const { cards } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);

// География — из русской коллекции для всех локалей. Переводы карточек хранят
// подписи вроде `region: Saint Petersburg`, и часть карточек географии не
// имеет вовсе: раньше английская страница строила фильтры по своему набору
// значений и часть каталога выпадала из фасетов. Ключ фильтра обязан быть один
// на все языки — иначе фасет не находит собственные карточки.
const geoById = buildGeoIndex(await getCollection("centers"));
const records = buildFacetRecords(cards, geoById);
const facets = buildCenterFacets(records, locale);
const geoByCardId = new Map(records.map((record) => [record.id, record]));
---

{/*
	Панель поиска живёт вне грида: у sticky-элемента внутри грида containing
	block — его грид-область, и в строке высотой с сам элемент запаса хода нет.
	Снаружи она липнет вдоль всей страницы, а в потоке всё равно стоит перед
	фильтрами, поэтому на мобильном панель фильтров по-прежнему раскрывается
	под своей кнопкой, а не над ней.

	Шапка сайта sticky только до lg (`lg:static`), поэтому на мобильном
	отступаем на её высоту, а на десктопе прижимаемся к нулю.
*/}
<div class="not-container bg-catalog px-5 pt-8 pb-12 sm:px-8 lg:px-12 lg:pt-10">
	<div
		data-catalog-bar
		class="sticky top-15 z-30 -mx-5 flex flex-col gap-2 bg-catalog px-5 py-2 sm:-mx-8 sm:px-8 lg:top-0 lg:-mx-12 lg:gap-3 lg:pr-12 lg:pb-5 lg:pl-[calc(var(--catalog-aside)+var(--catalog-gap)+3rem)] lg:pt-5"
	>
		<Search />
		<ActiveFilters />
	</div>

	<div
		class="grid grid-cols-1 gap-x-8 lg:grid-cols-[var(--catalog-aside)_minmax(0,1fr)] lg:gap-x-[var(--catalog-gap)]"
	>
		<Toolbar facets={facets} />

		<div>
			<GridCards cards={cards} geoByCardId={geoByCardId} />
			<NoResults />
		</div>
	</div>
</div>

<style>
	.not-container {
		--catalog-aside: 20rem;
		--catalog-gap: 3rem;
	}
</style>
