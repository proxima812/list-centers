---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import type { Facet } from "@/utils/centerFacets";
import FilterChip from "./FilterChip.astro";

// Заголовки групп («Страны», «Тип») сняты: смысл столбца читается по самим
// значениям, а для скринридеров он остался в `aria-label` у role="group".
//
// Секция целиком рендерится всегда, даже когда её не должно быть видно при
// текущем выборе: город появляется только после выбора страны или региона, но
// список городов уже лежит в разметке. Так фильтрация остаётся клиентской и
// мгновенной — иначе каждый клик по стране требовал бы запроса за списком её
// городов, а сайт статический.

interface Props {
	facet: Facet;
	/**
	 * Условие показа секции. Проверяет клиент; сервер только объявляет
	 * правило. `always` — секция видна всегда.
	 */
	gate?: string;
}

const { facet, gate = "always" } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const filterSectionClass =
	"border-b border-depth-100/70 pb-4 last:border-b-0 last:pb-0";
const filterGroupClass =
	"flex flex-wrap items-center gap-1.5 lg:flex-col lg:items-stretch lg:gap-0.5";
const moreButtonClass =
	"mt-0.5 inline-flex max-w-fit cursor-pointer text-xs font-medium text-muted-foreground underline decoration-border underline-offset-4 transition hover:text-foreground lg:mt-1 lg:px-2";
---

<section class={filterSectionClass} data-filter-section={facet.key} data-filter-gate={gate} hidden>
	<div
		class={filterGroupClass}
		role="group"
		aria-label={t(facet.ariaKey)}
		data-filter-group={facet.key}
		data-filter-limit={facet.limit}
	>
		<FilterChip group={facet.key} label={t(facet.allKey)} all />

		{
			facet.options.map((option) => (
				<FilterChip
					group={facet.key}
					value={option.value}
					label={option.label}
					count={option.count}
					flag={option.flag}
				/>
			))
		}
	</div>

	{/*
		Кнопка живёт вне группы и всегда есть в разметке: сколько опций уйдёт
		под неё, известно только клиенту — нулевые скрываются, и хвост меняется
		после каждого клика.
	*/}
	<button
		type="button"
		class={moreButtonClass}
		data-filter-more={facet.key}
		data-expanded="false"
		data-show-more={t("list.showMore", { count: "__COUNT__" })}
		data-show-less={t("list.showLess")}
		hidden
	>
	</button>
</section>
