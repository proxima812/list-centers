---
import type { CenterGeo } from "@/data/geo";
import { createCenterRouteIdMap } from "@/utils/centers";
import { getCenterLinks } from "@/utils/centerLinks";
import type { CollectionEntry } from "astro:content";
import CardItem from "../ui/CardItem.astro";

interface Props {
	cards: CollectionEntry<"centers" | "centersEn">[];
	geoByCardId?: Map<string, CenterGeo>;
}

const { cards, geoByCardId } = Astro.props as Props;
const routeIds = createCenterRouteIdMap(cards);
---

<section
	id="cards-grid"
	class="grid scroll-mt-28 grid-cols-1 gap-6 md:grid-cols-2 [&>[data-search-id]]:content-auto [&>[data-search-id]]:[contain-intrinsic-size:auto_22rem]"
>
	{
		cards.map((card) => (
			<CardItem
				id={card.id}
				routeId={routeIds.get(card.id)}
				title={card.data.title}
				summary={card.data.summary}
				type={card.data.type}
				category={card.data.category}
				location={card.data.location}
				region={card.data.location?.region}
				geo={geoByCardId?.get(card.id)}
				pubDate={card.data.pubDate}
				links={getCenterLinks(card.body, card.data.source)}
			/>
		))
	}
</section>
