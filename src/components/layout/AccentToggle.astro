---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/utils/libs/cn";

interface Props {
	class?: string;
}

// Образцы палитр — превью выбора, а не раскраска интерфейса, поэтому здесь
// литералы: кнопка «синей» палитры должна быть синей и в зелёной теме.
// Пары совпадают с --color-accent-vivid / --color-accent-glow в tailwind.css.
const items = [
	{ value: "green", labelKey: "accent.green", label: "Җаным Яшел", from: "hsl(142 76% 36%)", to: "hsl(142 71% 55%)" },
	{ value: "blue", labelKey: "accent.blue", label: "Кадерле Зәнгәр", from: "hsl(217 88% 44%)", to: "hsl(213 92% 62%)" },
	{ value: "violet", labelKey: "accent.violet", label: "Яна Шәмәха", from: "hsl(263 75% 50%)", to: "hsl(263 85% 68%)" },
];

const buttonClass =
	"inline-flex size-8 cursor-pointer items-center justify-center rounded-full transition-colors hover:bg-muted aria-checked:bg-muted";

const { class: className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div
	class={cn(
		"inline-flex items-center gap-0.5 rounded-full border border-border-muted p-0.5",
		className,
	)}
	role="radiogroup"
	aria-label={t("accent.switcher")}
	data-accent-switcher
>
	{
		items.map((item) => (
			<button
				type="button"
				class={buttonClass}
				data-accent-option={item.value}
				role="radio"
				aria-label={t(item.labelKey, undefined, item.label)}
				aria-checked="false"
				tabindex="-1"
			>
				<span
					class="size-4 rounded-full ring-1 ring-inset ring-shade/20"
					style={`background-image:linear-gradient(135deg, ${item.from}, ${item.to})`}
					aria-hidden="true"
				/>
			</button>
		))
	}
</div>

<script>
	import { initAppearance } from "@/scripts/appearance";

	initAppearance();
</script>
