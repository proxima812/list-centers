---
import LogoMark from "@/components/layout/LogoMark.astro";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<a
	href={localizePath(locale, "/")}
	class="inline-flex shrink-0 items-center gap-1 text-foreground no-underline"
	aria-label={`tatarverse - ${t("nav.home")}`}
>
	<LogoMark size={20} />

	<span class="text-sm">tatarverse</span>
</a>
