---
/**
 * Счётчик Яндекс.Метрики. Включается через `config.site.analytics.yandexMetrika`
 * в `src/config.ts`; вызывающий передаёт только `counterId` — см. Layout.astro.
 *
 * Раньше здесь лежал библиотечный компонент на 252 строки: ~20 опциональных
 * пропсов (webvisor, ecommerce, trustedDomains, lazy, timeout…), три поля
 * `any` и второй скрипт на `astro:page-load`. Событие даёт ClientRouter,
 * которого в проекте нет, — тот скрипт не выполнялся никогда. Пропсы, кроме
 * counterId, никто не передавал, а их значения по умолчанию совпадали с
 * дефолтами самой Метрики. Осталось то, что действительно работает.
 */
interface Props {
	counterId: number | string;
}

const { counterId } = Astro.props as Props;

// Значения, отличные от дефолтов Метрики: карта кликов, внешние ссылки и
// «точный показатель отказов» (15 секунд). Остальное — умолчания счётчика.
const initConfig = {
	clickmap: true,
	trackLinks: true,
	accurateTrackBounce: true,
	defer: true,
	ssr: true,
};
---

<script is:inline define:vars={{ counterId, initConfig }}>
	// Очередь вызовов: init можно поставить до загрузки tag.js.
	window.ym =
		window.ym ||
		function () {
			(window.ym.a = window.ym.a || []).push(arguments);
		};
	window.ym.l = 1 * new Date();
	ym(counterId, "init", initConfig);

	if (!document.getElementById(`ym-script-${counterId}`)) {
		const script = document.createElement("script");
		script.async = true;
		script.src = `https://mc.yandex.ru/metrika/tag.js?id=${counterId}`;
		script.id = `ym-script-${counterId}`;

		const firstScript = document.getElementsByTagName("script")[0];
		firstScript.parentNode.insertBefore(script, firstScript);
	}
</script>

<noscript>
	<div>
		<img
			src={`https://mc.yandex.ru/watch/${counterId}`}
			style="position:absolute; left:-9999px;"
			alt=""
		/>
	</div>
</noscript>
