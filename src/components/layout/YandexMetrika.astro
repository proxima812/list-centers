---
interface Props {
	counterId: number | string;
}

const { counterId } = Astro.props as Props;

const initConfig = {
	clickmap: true,
	trackLinks: true,
	accurateTrackBounce: true,
	defer: true,
	ssr: true,
};
---

<script is:inline define:vars={{ counterId, initConfig }}>
	window.ym =
		window.ym ||
		function () {
			(window.ym.a = window.ym.a || []).push(arguments);
		};
	window.ym.l = 1 * new Date();
	ym(counterId, "init", initConfig);

	if (!document.getElementById(`ym-script-${counterId}`)) {
		const script = document.createElement("script");
		script.async = true;
		script.src = `https://mc.yandex.ru/metrika/tag.js?id=${counterId}`;
		script.id = `ym-script-${counterId}`;

		const firstScript = document.getElementsByTagName("script")[0];
		firstScript.parentNode.insertBefore(script, firstScript);
	}
</script>

<noscript>
	<div>
		<img
			src={`https://mc.yandex.ru/watch/${counterId}`}
			style="position:absolute; left:-9999px;"
			alt=""
		/>
	</div>
</noscript>
