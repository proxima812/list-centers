---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/utils/libs/cn";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

// Вкл/выкл всей моушен-части сайта: CSS-анимации гасятся правилом на
// [data-motion="off"] в tailwind.css, а шейдерная марка в герое подменяется
// однотонной версией под текущую палитру.
const items = [
	{ value: "on", labelKey: "motion.on", label: "Animations on", icon: "tabler:wave-sine" },
	{ value: "off", labelKey: "motion.off", label: "Animations off", icon: "tabler:wave-square" },
];

// Та же пилюля, что у ThemeToggle в мобильном меню: рядом с AppearanceMenu
// нужен контрол одной высоты (h-9) и с той же рамкой.
const buttonClass =
	"inline-flex size-8 cursor-pointer items-center justify-center rounded-full text-subtle-foreground transition-colors hover:text-foreground aria-checked:bg-accent aria-checked:text-accent-foreground";

const { class: className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div
	class={cn(
		"inline-flex h-9 items-center gap-0.5 rounded-full border border-border-muted p-0.5",
		className,
	)}
	role="radiogroup"
	aria-label={t("motion.switcher")}
	data-motion-switcher
>
	{
		items.map((item) => (
			<button
				type="button"
				class={buttonClass}
				data-motion-option={item.value}
				role="radio"
				aria-label={t(item.labelKey, undefined, item.label)}
				title={t(item.labelKey, undefined, item.label)}
				aria-checked="false"
				tabindex="-1"
			>
				<Icon name={item.icon} class="size-4" aria-hidden="true" />
			</button>
		))
	}
</div>

<script>
	import { initAppearance } from "@/scripts/appearance";

	initAppearance();
</script>
