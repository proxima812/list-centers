---
import release from "@/data/release.json";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { Icon } from "astro-icon/components";
import Container from "./Container.astro";
import LogoMark from "./LogoMark.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const policyHref = localizePath(locale, "/policy");
const repositoryHref = "https://github.com/proxima812/tatarverse";
const codeLicenseHref = `${repositoryHref}/blob/main/LICENSE`;
const contentLicenseHref = `${repositoryHref}/blob/main/CONTENT-LICENSE.md`;
const suggestChangeHref = `${repositoryHref}/issues/new`;
const updatedAtLabel = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
	timeZone: "Asia/Almaty",
}).format(new Date(release.updatedAt));

// Подвал намеренно НЕ берёт токен `link`. Синий там — сигнал впустую: ссылками
// в подвале является всё подряд, и целая колонка синего перетягивает внимание с
// содержимого страницы. Сигнал кликабельности здесь несут позиция и список, а
// не цвет, поэтому тут нейтральные чернила с приглушённым подчёркиванием.
const baseStyle =
	"text-foreground underline decoration-current/40 underline-offset-4 transition hover:decoration-current";

type FooterLink = {
	href: string;
	label: string;
	icon?: string;
	nowrap?: boolean;
	props?: Record<string, string>;
};

const externalProps = {
	target: "_blank",
	rel: "noreferrer noopener",
};

const footerSections: Array<{ id: string; title: string; links: FooterLink[] }> = [
	{
		id: "navigation",
		title: t("footer.navigation.title"),
		links: [
			{
				href: localizePath(locale, "/centers"),
				label: t("nav.centers"),
			},
			{
				href: localizePath(locale, "/stats"),
				label: t("nav.stats"),
			},
			{
				href: localizePath(locale, "/thanks"),
				label: t("nav.thanks"),
			},
			{
				href: localizePath(locale, "/posts"),
				label: t("nav.posts"),
			},
		],
	},
	{
		id: "materials",
		title: t("footer.materials.title"),
		links: [
			{
				href: localizePath(locale, "/translations"),
				label: t("nav.translations"),
			},
			{
				href: localizePath(locale, "/sources"),
				label: t("nav.sources"),
			},
			{
				href: policyHref,
				label: t("footer.privacy"),
			},
		],
	},
	{
		id: "open-source",
		title: t("footer.openSource.title"),
		links: [
			{
				href: repositoryHref,
				label: t("footer.repository"),
				props: externalProps,
			},
			{
				href: suggestChangeHref,
				label: t("footer.suggestChange"),
				props: externalProps,
			},
			{
				href: codeLicenseHref,
				label: t("footer.codeLicense"),
				props: externalProps,
			},
			{
				href: contentLicenseHref,
				label: t("footer.contentLicense"),
				props: externalProps,
			},
		],
	},
];

// Framer держит контакты не колонкой ссылок, а рядом иконок рядом с копирайтом:
// это тот же список, но без колонки — четвертая колонка на mobile ломала
// баланс сетки, а подпись "Связь" рядом с тремя другими смысловыми разделами
// читалась слабее, чем узнаваемые иконки соцсетей.
const socialLinks: FooterLink[] = [
	{
		href: "mailto:kamil.mirikhan@gmail.com",
		label: "почта",
		icon: "mdi:email-outline",
	},
	{
		href: "https://www.instagram.com/the_tatarverse/",
		label: "@the_tatarverse",
		icon: "mdi:instagram",
		props: externalProps,
	},
	{
		href: "https://t.me/the_tatarverse",
		label: "@the_tatarverse (Telegram)",
		icon: "mdi:telegram",
		props: externalProps,
	},
	{
		href: "https://t.me/isembez",
		label: "@isembez",
		icon: "mdi:telegram",
		props: externalProps,
	},
];
---

<footer class="mt-auto overflow-hidden border-t border-border-muted pt-10 text-sm text-subtle-foreground sm:text-xs">
	<Container container class="max-w-7xl">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,2.5fr)]">
			<div class="space-y-3">
				<a
					href={localizePath(locale, "/")}
					class="inline-flex items-center gap-1.5 text-foreground no-underline"
				>
					<LogoMark size={22} />
					<span class="font-bold">tatarverse</span>
				</a>
				<p class="max-w-md leading-6">{t("footer.description")}</p>
				<p class="max-w-md leading-6">{t("footer.openSource.text")}</p>
				<p>v{release.version} · {t("footer.updated", { date: updatedAtLabel })}</p>
			</div>

			<nav aria-label={t("footer.links")} class="grid gap-6 sm:grid-cols-3">
				{
					footerSections.map((section) => (
						<section aria-labelledby={`footer-${section.id}`}>
							<p id={`footer-${section.id}`} class="mb-3 font-bold text-subtle-foreground">
								{section.title}
							</p>
							<ul class="space-y-2">
								{section.links.map((link) => (
									<li>
										<a
											href={link.href}
											class={`inline-flex min-h-6 min-w-0 max-w-full items-center gap-1.5 ${baseStyle}`}
											{...link.props}
										>
											{link.icon && (
												<Icon name={link.icon} class="size-4 shrink-0" aria-hidden="true" />
											)}
											<span
												class:list={[
													"min-w-0",
													link.nowrap ? "whitespace-nowrap" : "wrap-anywhere",
												]}
											>
												{link.label}
											</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</nav>
		</div>

		<div
			class="mt-10 flex flex-col-reverse gap-4 border-t border-border-muted pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>
				&copy; tatarverse.cc {new Date().getFullYear()} · {t("footer.legalNote")}
			</p>
			<div class="flex items-center gap-1.5">
				{
					socialLinks.map((link) => (
						<a
							href={link.href}
							class="inline-flex size-9 items-center justify-center rounded-full border border-border-muted text-subtle-foreground transition hover:border-border hover:text-foreground"
							aria-label={link.label}
							title={link.label}
							{...link.props}
						>
							<Icon name={link.icon} class="size-4" aria-hidden="true" />
						</a>
					))
				}
				<a
					href={repositoryHref}
					class="inline-flex size-9 items-center justify-center rounded-full border border-border-muted text-subtle-foreground transition hover:border-border hover:text-foreground"
					aria-label={t("footer.openSource.short")}
					title={t("footer.openSource.short")}
					{...externalProps}
				>
					<Icon name="mdi:github" class="size-4" aria-hidden="true" />
				</a>
			</div>
		</div>
	</Container>

	{
		/* Фирменная марка на всю ширину подвала, как у framer.com: подпись, а
		   не второй заголовок, поэтому чернила почти прозрачные и текст вне
		   таб-порядка — на плотных страницах каталога она не должна спорить с
		   контентом за внимание. */
	}
	<p
		aria-hidden="true"
		class="mt-8 -mb-2 select-none overflow-hidden text-center font-black leading-none tracking-tight text-foreground/[0.06] text-[20vw] sm:mt-12 sm:text-[13vw] lg:text-9xl"
	>
		tatarverse
	</p>
</footer>
