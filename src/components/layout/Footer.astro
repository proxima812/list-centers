---
import { pressMentions } from "@/data/press";
import release from "@/data/release.json";
import { byRecency } from "@/lib/center/order";
import { byNewest, localizedPosts } from "@/lib/post/collection";
import { externalLinkProps, siteLinks } from "@/lib/site/links";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import {
	createCenterRouteIdMap,
	getCenterPath,
	getCenterTranslationCollection,
} from "@/lib/center/centers";
import { getPostPath } from "@/lib/post/posts";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import Container from "./Container.astro";
import LogoMark from "./LogoMark.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const policyHref = localizePath(locale, "/policy");
const {
	repository: repositoryHref,
	codeLicense: codeLicenseHref,
	contentLicense: contentLicenseHref,
	suggestChange: suggestChangeHref,
} = siteLinks;
const updatedAtLabel = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
	timeZone: "Asia/Almaty",
}).format(new Date(release.updatedAt));

const allCenters = await getCollection("centers");
const centerRouteIds = createCenterRouteIdMap(allCenters);
const recentCenters = byRecency(allCenters).slice(0, 5);

const centerTranslationCollection = getCenterTranslationCollection(locale);
const translatedCenters = centerTranslationCollection
	? await getCollection(centerTranslationCollection)
	: [];
const centerTitle = (entry: (typeof allCenters)[number]) =>
	translatedCenters.find((translation) => translation.id === entry.id)?.data.title ??
	entry.data.title;

const recentPosts = byNewest(await localizedPosts(locale)).slice(0, 4);

const baseStyle =
	"text-[var(--footer-fg-muted)] transition-colors hover:text-[var(--footer-fg)]";

type FooterLink = {
	href: string;
	label: string;
	icon?: string;
	nowrap?: boolean;
	props?: Record<string, string>;
};

type FooterSection = {
	id: string;
	title: string;
	links: FooterLink[];
	clamp?: boolean;
};

const externalProps = externalLinkProps;

const footerSections: FooterSection[] = [
	{
		id: "navigation",
		title: t("footer.navigation.title"),
		links: [
			{
				href: localizePath(locale, "/centers"),
				label: t("nav.centers"),
			},
			{
				href: localizePath(locale, "/stats"),
				label: t("nav.stats"),
			},
			{
				href: localizePath(locale, "/thanks"),
				label: t("nav.thanks"),
			},
			{
				href: localizePath(locale, "/posts"),
				label: t("nav.posts"),
			},
			{
				href: localizePath(locale, "/changelog"),
				label: t("nav.changelog"),
			},
		],
	},
	{
		id: "materials",
		title: t("footer.materials.title"),
		links: [
			{
				href: localizePath(locale, "/translations"),
				label: t("nav.translations"),
			},
			{
				href: localizePath(locale, "/sources"),
				label: t("nav.sources"),
			},
			{
				href: localizePath(locale, "/centers/print"),
				label: t("nav.print"),
				icon: "mdi:printer-outline",
				nowrap: true,
			},
			{
				href: policyHref,
				label: t("footer.privacy"),
			},
		],
	},
	{
		id: "about",
		title: t("footer.about.title"),
		links: [
			{
				href: "https://vc.ru/life/3102323-poisk-tatarskikh-tsentrov-katalog-organizatsiy",
				label: t("footer.about.story"),
				props: externalProps,
			},
			...pressMentions.map((mention) => ({
				href: mention.href,
				label: t("footer.about.press", { outlet: mention.outlet }),
				props: externalProps,
			})),
		],
	},
	{
		id: "added",
		title: t("footer.added.title"),
		clamp: true,
		links: recentCenters.map((entry) => ({
			href: localizePath(locale, getCenterPath(centerRouteIds.get(entry.id) ?? entry.id)),
			label: centerTitle(entry),
		})),
	},
	{
		id: "posts",
		title: t("footer.posts.title"),
		clamp: true,
		links: recentPosts.map((entry) => ({
			href: localizePath(locale, getPostPath(entry.id)),
			label: entry.data.title,
		})),
	},
	{
		id: "open-source",
		title: t("footer.openSource.title"),
		links: [
			{
				href: repositoryHref,
				label: t("footer.repository"),
				props: externalProps,
			},
			{
				href: suggestChangeHref,
				label: t("footer.suggestChange"),
				props: externalProps,
			},
			{
				href: codeLicenseHref,
				label: t("footer.codeLicense"),
				props: externalProps,
			},
			{
				href: contentLicenseHref,
				label: t("footer.contentLicense"),
				props: externalProps,
			},
		],
	},
	{
		id: "contacts",
		title: t("footer.contacts.title"),
		links: [
			{
				href: "mailto:kamil.mirikhan@gmail.com",
				label: "почта",
				icon: "mdi:email-outline",
				nowrap: true,
			},
			{
				href: "https://www.instagram.com/the_tatarverse/",
				label: "@the_tatarverse",
				icon: "mdi:instagram",
				props: externalProps,
			},
			{
				href: "https://t.me/the_tatarverse",
				label: "@the_tatarverse",
				icon: "mdi:telegram",
				props: externalProps,
			},
			{
				href: "https://www.threads.com/@the_tatarverse",
				label: "@the_tatarverse",
				icon: "tabler:brand-threads",
				props: externalProps,
			},
			{
				href: "https://vk.ru/the_tatarverse",
				label: "@the_tatarverse",
				icon: "mdi:vk",
				props: externalProps,
			},
		],
	},
];

const sectionById = new Map(footerSections.map((section) => [section.id, section]));
const footerColumns: FooterSection[][] = [
	["navigation", "materials", "about"],
	["posts", "added"],
	["contacts", "open-source"],
].map((ids) => ids.map((id) => sectionById.get(id)).filter((s): s is FooterSection => !!s));
---

<footer
	class="site-footer rounded-t-[30px] md:rounded-t-[60px] mt-auto pt-15 pb-10 text-sm sm:text-xs"
>
	<Container container class="max-w-7xl">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,2.5fr)]">
			<div class="space-y-3">
				<a
					href={localizePath(locale, "/")}
					class="inline-flex items-center gap-1.5 text-[var(--footer-fg)] no-underline"
				>
					<LogoMark size={22} />
					<span class="font-bold">tatarverse</span>
				</a>
				<p class="max-w-md leading-6">{t("footer.description")}</p>
				<p class="max-w-md leading-6">{t("footer.openSource.text")}</p>
			</div>

			<nav aria-label={t("footer.links")} class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{
					footerColumns.map((column) => (
						<div class="space-y-8">
							{column.map((section) => (
								<section aria-labelledby={`footer-${section.id}`}>
									<p
										id={`footer-${section.id}`}
										class="mb-3 text-base font-semibold text-[var(--footer-fg)]"
									>
										{section.title}
									</p>
									<ul class="space-y-2 text-sm">
										{section.links.map((link) => (
											<li>
												<a
													href={link.href}
													class={`inline-flex min-h-6 min-w-0 max-w-full items-start gap-1.5 ${baseStyle}`}
													{...link.props}
												>
													{link.icon && (
														<Icon
															name={link.icon}
															class="size-4 shrink-0 translate-y-0.5"
															aria-hidden="true"
														/>
													)}
													<span
														class:list={[
															"min-w-0",
															link.nowrap ? "whitespace-nowrap" : "wrap-anywhere",
															section.clamp && "line-clamp-2",
														]}
													>
														{link.label}
													</span>
												</a>
											</li>
										))}
									</ul>
								</section>
							))}
						</div>
					))
				}
			</nav>
		</div>

		<div
			class="mt-10 flex flex-col gap-2 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
			style="border-color: var(--footer-border)"
		>
			<p>
				&copy; tatarverse.cc {new Date().getFullYear()} · {t("footer.legalNote")}
			</p>
			<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
				<a
					href={repositoryHref}
					class={`inline-flex min-w-0 max-w-full text-sm items-center gap-1.5 text-base ${baseStyle}`}
					{...externalProps}
				>
					<Icon name="mdi:github" class="size-4" aria-hidden="true" />
					<span class="min-w-0 wrap-anywhere">{t("footer.openSource.short")}</span>
				</a>

				<p class="text-sm text-[var(--footer-fg-muted)]">
					v{release.version} · {t("footer.updated", { date: updatedAtLabel })}
				</p>
			</div>
		</div>
	</Container>
</footer>

