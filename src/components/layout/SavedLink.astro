---
import { getLocaleFromUrl, getLocalePathname, localizePath, useTranslations } from "@/i18n";
import { cn } from "@/lib/cn";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	withLabel?: boolean;
	bare?: boolean;
}

const { class: className, withLabel = false, bare = false } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const href = localizePath(locale, "/saved");
const isActive = getLocalePathname(Astro.url.pathname) === getLocalePathname(href);
---

<a
	href={href}
	aria-current={isActive ? "page" : undefined}
	aria-label={t("saved.title")}
	title={t("saved.title")}
	class={cn(
		"inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-border-muted px-2.5 text-sm font-medium text-foreground no-underline transition-colors hover:bg-muted aria-[current]:bg-muted",
		bare && "h-8 border-transparent hover:bg-subtle aria-[current]:bg-subtle",
		withLabel &&
			"h-auto w-full max-w-full justify-start gap-2 border-transparent px-4 py-2 text-lg",
		className,
	)}
>
	<span class="relative inline-flex shrink-0">
		<Icon
			name="tabler:bookmark"
			class={withLabel ? "size-5" : "size-4.5"}
			aria-hidden="true"
		/>
		<span
			data-saved-count
			class="absolute -right-1.5 -top-1.5 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-semibold leading-none tabular-nums text-accent-foreground ring-2 ring-background"
			hidden></span>
	</span>
	{withLabel && <span class="min-w-0 wrap-anywhere">{t("saved.title")}</span>}
</a>

<script>
	import { initSavedCenters } from "@/lib/scripts/savedCentersUi";

	initSavedCenters();
</script>
