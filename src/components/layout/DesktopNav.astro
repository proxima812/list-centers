---
import ButtonLink from "../ui/ButtonLink.astro";
import { links } from "@/data/links";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";

const currentLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

const materialHrefs = new Set(["/translations", "/sources", "/policy"]);
const otherHrefs = new Set(["/thanks", "/map"]);
const topLevelLinks = links.filter(
	(item) => !materialHrefs.has(item.href) && !otherHrefs.has(item.href),
);
const materialLinks = links.filter((item) => materialHrefs.has(item.href));
const otherLinks = links.filter((item) => otherHrefs.has(item.href));

const currentPath = Astro.url.pathname.replace(/^\/(?:ru|en)(?=\/|$)/, "") || "/";
const normalizePath = (path: string) => (path === "/" ? "/" : path.replace(/\/+$/, ""));
const isActivePath = (href: string) => {
	const itemPath = normalizePath(href);
	const pagePath = normalizePath(currentPath);

	return itemPath === "/"
		? pagePath === "/"
		: pagePath === itemPath || pagePath.startsWith(`${itemPath}/`);
};

const dropdowns = [
	{ id: "materials", labelKey: "menu.materials", items: materialLinks },
	{ id: "other", labelKey: "menu.other", items: otherLinks },
].filter((dropdown) => dropdown.items.length > 0);

const triggerClass =
	"inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-2xl px-3 text-sm font-medium transition-colors hover:bg-muted";

// Активная страница помечается чертой снизу в цвете акцента: цвет тянется из
// --color-accent, поэтому линия сама меняется вместе с пресетом темы
// (зелёный / синий / фиолетовый).
const activeUnderlineClass =
	"relative after:absolute after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-accent after:content-['']";

const itemClass =
	"flex items-center gap-2 rounded-2xl px-3 py-2 text-sm font-medium text-subtle-foreground no-underline transition-colors hover:bg-muted hover:text-foreground aria-[current]:bg-muted aria-[current]:text-foreground ";
---

<nav class="hidden items-center gap-1 lg:flex" aria-label={t("nav.primary")}>
	{
		topLevelLinks.map((item) => (
			<ButtonLink
				variant="ghost"
				href={item.href}
				target={item.target}
				label={item.label}
				labelKey={item.labelKey}
				aria-current={isActivePath(item.href) ? "page" : undefined}
				class={isActivePath(item.href) ? `${activeUnderlineClass} after:inset-x-4` : ""}
			/>
		))
	}

	{
		dropdowns.map((dropdown) => {
			const isActive = dropdown.items.some((item) => isActivePath(item.href));

			return (
				<div class="relative" data-dropdown-menu>
					<button
						type="button"
						data-dropdown-trigger
						class={`${triggerClass} text-foreground ${isActive ? `${activeUnderlineClass} after:inset-x-3` : ""}`}
						aria-haspopup="true"
						aria-expanded="false"
						aria-controls={`${dropdown.id}-dropdown`}
					>
						<span>{t(dropdown.labelKey)}</span>
						<svg
							aria-hidden="true"
							viewBox="0 0 16 16"
							class="size-3.5 shrink-0 transition-transform duration-200"
							data-dropdown-chevron
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
						>
							<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>

					<div
						id={`${dropdown.id}-dropdown`}
						data-dropdown-panel
						class="absolute left-0 top-full z-[90] mt-2 min-w-48 rounded-2xl border border-border-muted bg-surface p-1 overlay-lift"
						hidden
					>
						{dropdown.items.map((item) => (
							<a
								href={localizePath(currentLocale, item.href)}
								target={item.target}
								class={itemClass}
								aria-current={isActivePath(item.href) ? "page" : undefined}
							>
								{t(item.labelKey, undefined, item.label)}
							</a>
						))}
					</div>
				</div>
			);
		})
	}
</nav>

<script>
	document.querySelectorAll<HTMLElement>("[data-dropdown-menu]").forEach((root) => {
		const trigger = root.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
		const panel = root.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = root.querySelector<HTMLElement>("[data-dropdown-chevron]");

		if (!trigger || !panel) return;

		const setOpen = (isOpen: boolean) => {
			panel.hidden = !isOpen;
			trigger.setAttribute("aria-expanded", String(isOpen));
			chevron?.classList.toggle("rotate-180", isOpen);
		};

		trigger.addEventListener("click", () => {
			setOpen(Boolean(panel.hidden));
		});

		document.addEventListener("click", (event) => {
			if (event.target instanceof Node && !root.contains(event.target)) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || panel.hidden) return;

			setOpen(false);
			trigger.focus();
		});
	});
</script>
