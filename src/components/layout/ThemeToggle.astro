---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/utils/libs/cn";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

const items = [
	{ value: "system", labelKey: "theme.system", label: "System theme", icon: "tabler:app-window" },
	{ value: "light", labelKey: "theme.light", label: "Light theme", icon: "tabler:sun-high" },
	{ value: "dark", labelKey: "theme.dark", label: "Dark theme", icon: "tabler:moon" },
];

const buttonClass =
	"inline-flex size-8 cursor-pointer items-center justify-center rounded-full text-subtle-foreground transition-colors hover:text-foreground aria-checked:bg-accent aria-checked:text-accent-foreground";

const { class: className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div
	class={cn(
		"inline-flex items-center gap-0.5 rounded-full border border-border-muted p-0.5",
		className,
	)}
	role="radiogroup"
	aria-label={t("theme.switcher")}
	data-theme-switcher
>
	{
		items.map((item) => (
			<button
				type="button"
				class={buttonClass}
				data-theme-option={item.value}
				role="radio"
				aria-label={t(item.labelKey, undefined, item.label)}
				aria-checked="false"
				tabindex="-1"
			>
				<Icon name={item.icon} class="size-4" aria-hidden="true" />
			</button>
		))
	}
</div>

<script>
	import { initAppearance } from "@/scripts/appearance";

	initAppearance();
</script>
