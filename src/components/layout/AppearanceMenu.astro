---
import { appearanceOption } from "@/lib/site/appearanceAttributes";
import { APPEARANCE_SPECS } from "@/lib/site/appearance";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/lib/cn";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import blueSwatch from "@/assets/images/palettes/blue.png";
import defaultSwatch from "@/assets/images/palettes/default.png";
import greenSwatch from "@/assets/images/palettes/green.png";
import pinkSwatch from "@/assets/images/palettes/pink.png";
import purpleSwatch from "@/assets/images/palettes/purple.png";
import redSwatch from "@/assets/images/palettes/red.png";

interface Props {
	class?: string;
	bare?: boolean;
}

// Списки те же, что у пилюль в мобильном меню, — из общей таблицы.
const themes = APPEARANCE_SPECS.theme.options;
const accents = APPEARANCE_SPECS.accent.options;

const groupLabelClass =
	"px-2 pb-1 text-xs font-medium uppercase tracking-wide text-subtle-foreground";




// Палитра показывается картинкой шара, а не плоским кружком: подпись не нужна,
// цвет сам себя называет.
const SWATCH_IMAGES: Record<string, ImageMetadata> = {
	default: defaultSwatch,
	green: greenSwatch,
	blue: blueSwatch,
	violet: purpleSwatch,
	red: redSwatch,
	pink: pinkSwatch,
};

const optionClass =
	"flex w-full cursor-pointer items-center gap-2.5 rounded-control px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-checked:bg-muted aria-checked:font-medium aria-checked:text-foreground";

const { class: className, bare = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div class={cn("relative", className)} data-appearance-menu>
	<button
		type="button"
		data-appearance-trigger
		class={cn(
			"inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-border-muted pl-1.5 pr-2 text-sm font-medium text-foreground transition-colors hover:bg-muted",
			bare && "h-8 border-transparent hover:bg-subtle",
		)}
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="appearance-panel"
		aria-label={t("appearance.switcher")}
	>
		<span class="appearance-dot size-5" aria-hidden="true">
			{
				accents.map((item) => (
					<Image
						src={SWATCH_IMAGES[item.value]}
						alt=""
						widths={[40, 80]}
						sizes="20px"
						class="size-5 rounded-full"
						data-accent-image={item.value}
					/>
				))
			}
		</span>
		<svg
			aria-hidden="true"
			viewBox="0 0 16 16"
			class="size-3.5 shrink-0 transition-transform duration-200"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
		>
			<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>

	<div
		id="appearance-panel"
		data-appearance-panel
		hidden
		class="absolute right-0 top-full z-[90] mt-2 w-64 max-w-[calc(100vw-2rem)] rounded-control corner-squircle border border-border-muted bg-surface p-1.5 overlay-lift"
	>
		<p class={groupLabelClass} id="appearance-theme-label">{t("appearance.theme")}</p>
		<div role="radiogroup" aria-labelledby="appearance-theme-label">
			{
				themes.map((item) => (
					<button
						type="button"
						class={optionClass}
						{...appearanceOption("theme", item.value)}
						role="radio"
						aria-checked="false"
						tabindex="-1"
					>
						<Icon name={item.icon} class="size-4 shrink-0" aria-hidden="true" />
						<span class="min-w-0 flex-1 truncate text-left">
							{t(item.shortLabelKey, undefined, item.label)}
						</span>
						<Icon
							name="tabler:check"
							class="size-4 shrink-0 text-accent opacity-0 aria-checked-visible"
							aria-hidden="true"
						/>
					</button>
				))
			}
		</div>

		<p class={`${groupLabelClass} pt-2`} id="appearance-accent-label">
			{t("appearance.palette")}
		</p>
		<div
			class="flex items-center justify-between gap-1 px-1 pt-1"
			role="radiogroup"
			aria-labelledby="appearance-accent-label"
		>
			{
				accents.map((item) => {
					const label = t(item.shortLabelKey, undefined, item.label);

					return (
						<button
							type="button"
							class="cursor-pointer rounded-full p-0.5 ring-2 ring-transparent transition-[box-shadow,transform] hover:scale-105 aria-checked:ring-accent"
							{...appearanceOption("accent", item.value)}
							role="radio"
							aria-label={label}
							title={label}
							aria-checked="false"
							tabindex="-1"
						>
							<Image
								src={SWATCH_IMAGES[item.value]}
								alt=""
								widths={[64, 128]}
								sizes="32px"
								class="size-8 rounded-full"
								aria-hidden="true"
							/>
						</button>
					);
				})
			}
		</div>

	</div>
</div>


<script>
	import { initAppearance } from "@/lib/scripts/appearance";

	initAppearance();
</script>
