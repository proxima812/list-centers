---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/utils/libs/cn";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

const themes = [
	{ value: "system", labelKey: "theme.system", label: "System", icon: "tabler:app-window" },
	{ value: "light", labelKey: "theme.light", label: "Light", icon: "tabler:sun-high" },
	{ value: "dark", labelKey: "theme.dark", label: "Dark", icon: "tabler:moon" },
];

// Образцы палитр — превью выбора, а не раскраска интерфейса, поэтому здесь
// литералы: кнопка «синей» палитры должна быть синей и в зелёной теме.
// Пары совпадают с --color-accent-vivid / --color-accent-glow в tailwind.css.
const accents = [
	{ value: "green", labelKey: "accent.green", label: "Green", from: "hsl(142 76% 36%)", to: "hsl(142 71% 55%)" },
	{ value: "blue", labelKey: "accent.blue", label: "Blue", from: "hsl(217 88% 44%)", to: "hsl(213 92% 62%)" },
	{ value: "violet", labelKey: "accent.violet", label: "Violet", from: "hsl(263 75% 50%)", to: "hsl(263 85% 68%)" },
];

const groupLabelClass =
	"px-2 pb-1.5 text-xs font-semibold uppercase tracking-wide text-subtle-foreground";
const optionClass =
	"flex cursor-pointer flex-col items-center gap-1.5 rounded-xl px-2 py-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-checked:bg-accent aria-checked:text-accent-foreground";

const { class: className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div class={cn("relative", className)} data-appearance-menu>
	<button
		type="button"
		data-appearance-trigger
		class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border border-border-muted pl-1.5 pr-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="appearance-panel"
		aria-label={t("appearance.switcher")}
	>
		<span class="appearance-dot size-5 rounded-full" aria-hidden="true"></span>
		<svg
			aria-hidden="true"
			viewBox="0 0 16 16"
			class="size-3.5 shrink-0 transition-transform duration-200"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
		>
			<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>

	<div
		id="appearance-panel"
		data-appearance-panel
		hidden
		class="absolute right-0 top-full z-[90] mt-2 w-56 rounded-2xl corner-squircle border border-border-muted bg-background p-2 shadow-lg shadow-shade/10 dark:shadow-shade/60"
	>
		<p class={groupLabelClass}>{t("theme.switcher")}</p>
		<div
			class="grid grid-cols-3 gap-1"
			role="radiogroup"
			aria-label={t("theme.switcher")}
			data-theme-switcher
		>
			{
				themes.map((item) => (
					<button
						type="button"
						class={optionClass}
						data-theme-option={item.value}
						role="radio"
						aria-checked="false"
						tabindex="-1"
					>
						<Icon name={item.icon} class="size-4" aria-hidden="true" />
						<span>{t(item.labelKey, undefined, item.label).split(" ")[0]}</span>
					</button>
				))
			}
		</div>

		<p class={`${groupLabelClass} pt-3`}>{t("accent.switcher")}</p>
		<div
			class="grid grid-cols-3 gap-1"
			role="radiogroup"
			aria-label={t("accent.switcher")}
			data-accent-switcher
		>
			{
				accents.map((item) => (
					<button
						type="button"
						class={optionClass}
						data-accent-option={item.value}
						role="radio"
						aria-label={t(item.labelKey, undefined, item.label)}
						aria-checked="false"
						tabindex="-1"
					>
						<span
							class="size-5 rounded-full ring-1 ring-inset ring-shade/20"
							style={`background-image:linear-gradient(135deg, ${item.from}, ${item.to})`}
							aria-hidden="true"
						/>
						<span>{t(item.labelKey, undefined, item.label).split(" ")[0]}</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	/* Точка на кнопке показывает текущую палитру и живёт на токенах, а не на
	   литералах: тем же градиентом залито слово в герое. */
	.appearance-dot {
		background-image: linear-gradient(
			135deg,
			var(--color-accent-vivid),
			var(--color-accent-glow)
		);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-shade) 20%, transparent);
	}

	[data-appearance-trigger][aria-expanded="true"] svg {
		transform: rotate(180deg);
	}
</style>

<script>
	import { initAppearance } from "@/scripts/appearance";

	initAppearance();
</script>
