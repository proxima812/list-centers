---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { ACCENT_PRESETS } from "@/utils/accents";
import { cn } from "@/utils/libs/cn";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	bare?: boolean;
}

const themes = [
	{ value: "system", labelKey: "theme.system.short", label: "System", icon: "tabler:app-window" },
	{ value: "light", labelKey: "theme.light.short", label: "Light", icon: "tabler:sun-high" },
	{ value: "dark", labelKey: "theme.dark.short", label: "Dark", icon: "tabler:moon" },
];

const accents = ACCENT_PRESETS;

const groupLabelClass =
	"px-2 pb-1 text-xs font-medium uppercase tracking-wide text-subtle-foreground";




const optionClass =
	"flex w-full cursor-pointer items-center gap-2.5 rounded-control px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-checked:bg-muted aria-checked:font-medium aria-checked:text-foreground";

const { class: className, bare = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div class={cn("relative", className)} data-appearance-menu>
	<button
		type="button"
		data-appearance-trigger
		class={cn(
			"inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-border-muted pl-1.5 pr-2 text-sm font-medium text-foreground transition-colors hover:bg-muted",
			bare && "h-8 border-transparent hover:bg-subtle",
		)}
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="appearance-panel"
		aria-label={t("appearance.switcher")}
	>
		<span class="appearance-dot size-5 rounded-full" aria-hidden="true"></span>
		<svg
			aria-hidden="true"
			viewBox="0 0 16 16"
			class="size-3.5 shrink-0 transition-transform duration-200"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
		>
			<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>

	<div
		id="appearance-panel"
		data-appearance-panel
		hidden
		class="absolute right-0 top-full z-[90] mt-2 w-52 max-w-[calc(100vw-2rem)] rounded-control corner-squircle border border-border-muted bg-surface p-1.5 overlay-lift"
	>
		<p class={groupLabelClass} id="appearance-theme-label">{t("appearance.theme")}</p>
		<div role="radiogroup" aria-labelledby="appearance-theme-label" data-theme-switcher>
			{
				themes.map((item) => (
					<button
						type="button"
						class={optionClass}
						data-theme-option={item.value}
						role="radio"
						aria-checked="false"
						tabindex="-1"
					>
						<Icon name={item.icon} class="size-4 shrink-0" aria-hidden="true" />
						<span class="min-w-0 flex-1 truncate text-left">
							{t(item.labelKey, undefined, item.label)}
						</span>
						<Icon
							name="tabler:check"
							class="size-4 shrink-0 text-accent opacity-0 aria-checked-visible"
							aria-hidden="true"
						/>
					</button>
				))
			}
		</div>

		<p class={`${groupLabelClass} pt-2`} id="appearance-accent-label">
			{t("appearance.palette")}
		</p>
		<div role="radiogroup" aria-labelledby="appearance-accent-label" data-accent-switcher>
			{
				accents.map((item) => (
					<button
						type="button"
						class={optionClass}
						data-accent-option={item.value}
						role="radio"
						aria-checked="false"
						tabindex="-1"
					>
						<span
							class="size-4 shrink-0 rounded-full ring-1 ring-inset ring-shade/20"
							style={`background-image:linear-gradient(135deg, ${item.from}, ${item.to})`}
							aria-hidden="true"
						/>
						<span class="min-w-0 flex-1 truncate text-left">
							{t(item.labelKey, undefined, item.label)}
						</span>
						<Icon
							name="tabler:check"
							class="size-4 shrink-0 text-accent opacity-0 aria-checked-visible"
							aria-hidden="true"
						/>
					</button>
				))
			}
		</div>

	</div>
</div>

<style>
	
	.appearance-dot {
		background-image: linear-gradient(
			135deg,
			var(--color-accent-vivid),
			var(--color-accent-glow)
		);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-shade) 20%, transparent);
	}

	[data-appearance-trigger][aria-expanded="true"] svg {
		transform: rotate(180deg);
	}

	
	[aria-checked="true"] .aria-checked-visible {
		opacity: 1;
	}
</style>

<script>
	import { initAppearance } from "@/scripts/appearance";

	initAppearance();
</script>
