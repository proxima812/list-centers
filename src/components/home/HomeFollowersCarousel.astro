---
import { followers } from "@/data/inst_follows";

const rows = Array.from({ length: 5 }, (_, rowIndex) => {
	const rowFollowers = followers.filter((_, index) => index % 5 === rowIndex);

	return {
		followers: [...rowFollowers, ...rowFollowers],
		isReverse: rowIndex % 2 === 1,
	};
});
---

{
	followers.length > 0 && (
		<section
			class="not-container overflow-hidden"
			aria-labelledby="endorsements-title"
		>
			<div class="mx-auto flex text-center w-full max-w-6xl flex-col py-6 gap-5 px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					Tolerated by over 100,000 devs
				</h2>
				<p>Some of them even tweeted about it.</p>
			</div>

			<div class="fade-x py-6  flex flex-col gap-3 overflow-hidden">
				{rows.map(({ followers: rowFollowers, isReverse }) => (
					<ul
						class:list={[
							"followers-carousel-track flex w-max gap-3 motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:px-4",
							isReverse && "followers-carousel-track-reverse",
						]}
					>
						{rowFollowers.map(({ handle, name }, index) => (
							<li
								class="flex min-w-48 max-w-64 shrink-0 flex-col rounded-control bg-muted px-2.5 py-2 text-sm text-foreground"
								aria-hidden={index >= rowFollowers.length / 2 ? "true" : undefined}
							>
								<span class="truncate font-semibold">{handle}</span>
								{name && <span class="truncate text-muted-foreground">{name}</span>}
							</li>
						))}
					</ul>
				))}
			</div>
		</section>
	)
}

<style>
	.followers-carousel-track {
		animation: followers-carousel-scroll 500s linear infinite;
	}

	.followers-carousel-track-reverse {
		animation-direction: reverse;
	}

	@media (prefers-reduced-motion: reduce) {
		.followers-carousel-track {
			animation: none;
			width: auto;
		}
	}

	@keyframes followers-carousel-scroll {
		to {
			transform: translateX(-50%);
		}
	}
</style>
