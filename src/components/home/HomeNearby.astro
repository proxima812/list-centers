---
import nearbyEnDark from "@/assets/images/nearby-en-dark.png";
import nearbyEnLight from "@/assets/images/nearby-en-light.png";
import nearbyRuDark from "@/assets/images/nearby-ru-dark.png";
import nearbyRuLight from "@/assets/images/nearby-ru-light.png";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { Image } from "astro:assets";
import ButtonLink from "../ui/ButtonLink.astro";

/**
 * Поиск по геолокации: обещание раздела `/nearby`.
 *
 * Материал нарисован в четырёх вариантах — язык × тема. Тему нельзя выбрать
 * на сервере: она живёт в localStorage и ставится до первой отрисовки, —
 * поэтому обе картинки попадают в разметку, а показывает нужную CSS. Так
 * при переключении темы не мигает старая версия.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const light = locale === "en" ? nearbyEnLight : nearbyRuLight;
const dark = locale === "en" ? nearbyEnDark : nearbyRuDark;
const alt = t("home.nearby.imageAlt");
const sizes = "(min-width: 768px) 50vw, 100vw";
const widths = [400, 640, 768, 1200];
---

<section class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
	<div class="space-y-6">
		<h2 class="text-4xl font-bold tracking-tight">{t("home.nearby.title")}</h2>
		<p class="leading-7 text-muted-foreground">{t("home.nearby.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.nearby.text2")}</p>
		<ButtonLink
			href="/nearby"
			labelKey="nav.nearby"
			label="Центры рядом"
			icon="mdi:map-marker-radius-outline"
			variant="gradient"
		/>
	</div>

	<Image src={light} alt={alt} widths={widths} sizes={sizes} class="w-full dark:hidden" />
	<Image src={dark} alt={alt} widths={widths} sizes={sizes} class="hidden w-full dark:block" />
</section>
