---
import { Image } from "astro:assets";

/**
 * Секция главной «картинка и текст». Две такие стояли инлайном в
 * `HomeSections` зеркальными копиями - и уже разъехались по классам
 * заголовка.
 *
 * Текст приходит слотом: в одной секции это обычные абзацы, в другой -
 * `set:html` со счётчиками каталога.
 */
interface Props {
	image: ImageMetadata;
	imageAlt: string;
	title: string;
	/** Картинка слева на десктопе, текст справа. */
	reversed?: boolean;
	/** Первый экран: картинка грузится вперёд остальных. */
	priority?: boolean;
}

const { image, imageAlt, title, reversed = false, priority = false } = Astro.props as Props;
---

<section class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
	<Image
		src={image}
		alt={imageAlt}
		widths={[400, 640, 768, 1200]}
		sizes="(min-width: 768px) 50vw, 100vw"
		loading={priority ? "eager" : undefined}
		fetchpriority={priority ? "high" : undefined}
		class:list={["order-2 h-full w-full rounded-card object-cover", reversed && "md:order-1"]}
	/>
	<div class:list={["order-1 space-y-6", reversed && "md:order-2"]}>
		<h2 class="text-4xl font-bold tracking-tight">{title}</h2>
		<slot />
	</div>
</section>
