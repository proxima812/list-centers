---
import searchImageEn from "@/assets/1-en.png";
import searchImageRu from "@/assets/1-ru.png";
import present from "@/assets/present.png";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// Коллекция читается тут же, а не приходит пропом: getCollection у Astro
// кеширован, а компонент так остаётся самодостаточным — как HomeLinks.
const allCenters = await getCollection("centers");
const centers = allCenters.length;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const countriesCount = new Set(
	allCenters.map((center) => center.data.location?.country).filter(Boolean),
).size;
const regionsCount = new Set(
	allCenters.map((center) => center.data.location?.region).filter(Boolean),
).size;

// Скриншот каталога локализован: на /en/ подписи внутри картинки английские.
const searchImage = locale === "en" ? searchImageEn : searchImageRu;
---

<div id="sections" class="md:space-y-14 space-y-8 py-12 md:py-20">
	<section
		class="grid grid-cols-1 items-center overflow-hidden rounded-3xl bg-surface surface-lift ring-1 ring-border-muted md:grid-cols-2"
	>
		<Image
			src={present}
			alt={t("home.present.imageAlt")}
			class="h-full w-full object-cover"
		/>
		<div class="space-y-6 px-6 py-10 sm:px-8 md:px-12 md:py-16">
			<h2 class="text-4xl font-bold tracking-tight">{t("home.present.title")}</h2>
			<p
				class="leading-7 text-muted-foreground"
				set:html={t("home.present.caption", {
					centers,
					countries: countriesCount,
					regions: regionsCount,
				})}
			/>
			<p class="leading-7 text-muted-foreground">{t("home.present.text1")}</p>
			<p class="leading-7 text-muted-foreground">{t("home.present.text2")}</p>
		</div>
	</section>
	<section
		class="grid grid-cols-1 items-center overflow-hidden rounded-3xl bg-surface surface-lift ring-1 ring-border-muted md:grid-cols-2"
	>
		<div class="order-2 space-y-6 px-6 py-10 sm:px-8 md:order-1 md:px-12 md:py-16">
			<h2 class="text-4xl font-bold tracking-tight">
				{t("home.search.title")}
			</h2>

			<p class="leading-7 text-muted-foreground">
				{t("home.search.text1")}
			</p>

			<p class="leading-7 text-muted-foreground">
				{t("home.search.text2")}
			</p>
		</div>
		<Image
			src={searchImage}
			alt={t("home.search.imageAlt")}
			class="order-1 h-full w-full object-cover md:order-2"
		/>
	</section>
</div>
