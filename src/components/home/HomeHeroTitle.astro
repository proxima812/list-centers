---
import { getLocaleFromUrl, useTranslations } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const solidClass = "font-black tracking-tight md:tracking-[-1.4px]";

// Градиенты собраны в <style> ниже, а не в arbitrary-классах: они тянутся из
// токенов темы и в записи Tailwind превратились бы в нечитаемую строку с
// подчёркиваниями вместо пробелов.
const heroLines = [
	{ key: "home.hero.1", className: `${solidClass} text-foreground` },
	{ key: "home.hero.2", className: `${solidClass} hero-accent motion-safe:animate-hero-pulse` },
	{ key: "home.hero.3", className: `${solidClass} text-foreground/90` },
] as const;

// Небольшой сдвиг фаз, чтобы слова не мерцали синхронно.
const heroLines2 = [
	{ key: "home.hero.5", className: `${solidClass} hero-drift hero-drift--dim` },
	{ key: "home.hero.6", className: `${solidClass} hero-drift hero-drift--strong` },
	{ key: "home.hero.7", className: `${solidClass} hero-drift hero-drift--dim` },
] as const;

const titleClass = "uppercase inline-block";
---

<h1 class="relative select-none text-center text-3xl sm:text-5xl md:text-6xl lg:text-7xl">
	<div
		class="flex flex-wrap items-center justify-center md:gap-0 gap-x-2 md:space-x-3.5 md:space-y-2"
	>
		{
			heroLines.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
	<div
		class="flex flex-wrap items-center justify-center md:gap-0 gap-x-2 md:space-x-3.5 md:space-y-2"
	>
		{
			heroLines2.map(({ key, className }, index) => (
				<span class:list={[titleClass, className]} style={`--drift-delay: ${-2 - index * 4}s`}>
					{t(key)}
				</span>
			))
		}
	</div>
</h1>

<style>
	/* Акцентная строка. Оттенки выводятся из --color-accent, поэтому смена
	   палитры перекрашивает герой целиком, включая ореол hero-pulse. */
	.hero-accent {
		color: transparent;
		background-clip: text;
		background-image: linear-gradient(
			120deg,
			var(--color-accent),
			color-mix(in oklab, var(--color-accent) 60%, white),
			color-mix(in oklab, var(--color-accent) 85%, white),
			var(--color-accent)
		);
	}

	/* Тихий дрейф второй строки: узкий диапазон вокруг foreground, движение
	   еле заметно и не спорит с акцентом. */
	.hero-drift {
		color: transparent;
		background-clip: text;
		background-image: linear-gradient(
			90deg,
			color-mix(in oklab, var(--color-foreground) 60%, var(--color-background)),
			var(--color-foreground),
			color-mix(in oklab, var(--color-foreground) 75%, var(--color-background)),
			var(--color-foreground),
			color-mix(in oklab, var(--color-foreground) 60%, var(--color-background))
		);
		background-size: 220% 100%;
		background-position: 0% 50%;
	}

	.hero-drift--dim {
		opacity: 0.55;
	}

	.hero-drift--strong {
		opacity: 0.95;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-drift {
			animation: var(--animate-hero-gray-drift);
			animation-delay: var(--drift-delay, 0s);
		}
	}
</style>
