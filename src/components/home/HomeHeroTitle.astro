---
import { getLocaleFromUrl, useTranslations, type AppLocale } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const solidClass = "font-black tracking-tight md:tracking-[-1.4px]";




const heroLines = [
	{ key: "home.hero.1", className: `${solidClass} text-foreground` },
	{
		key: "home.hero.2",
		className: `${solidClass} hero-accent motion-safe:animate-hero-pulse`,
	},
	{ key: "home.hero.3", className: `${solidClass} text-foreground/90` },
] as const;





const heroLines2 = [
	{ key: "home.hero.5", className: `${solidClass} text-muted-foreground` },
	{ key: "home.hero.6", className: `${solidClass} text-foreground` },
	{ key: "home.hero.7", className: `${solidClass} text-muted-foreground` },
] as const;

const titleClass = "uppercase inline-block";

/**
 * Размер тянется за шириной, а не прыгает по брейкпоинтам — и у каждого языка
 * он свой. Контейнер один и тот же (`max-w-5xl`, 984px контента), а самая
 * длинная строка разная: «Язык. Культура. Люди.» занимает 13.4em, а
 * «Language. Culture. People.» — 15.4em. С русским коэффициентом английский
 * рвался на три строки с одиноким «People.» внизу.
 *
 * Литералы записаны целиком: Tailwind сканирует исходник, и класс, собранный
 * из переменной, до него не дойдёт.
 *
 * Меняешь текст заголовка — перемеряй. Все три числа считаются от ширины
 * самой длинной строки в em: наклон = 100 / ширина с запасом ~5%, потолок =
 * 984 / ширина, нижняя граница = 280 / ширина (280px — контент на экране
 * шириной 320). У английского нижняя граница своя не от красоты: с русской
 * строка не влезала на самых узких телефонах.
 */
const heroSizeClass: Record<AppLocale, string> = {
	ru: "text-[clamp(1.25rem,calc(7.1vw-3px),4.5rem)]",
	en: "text-[clamp(1.05rem,calc(6.2vw-3px),3.75rem)]",
};
---

<h1
	class:list={[
		"relative select-none text-center leading-none",
		heroSizeClass[locale] ?? heroSizeClass.ru,
	]}
>
	<div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-2 md:gap-x-3.5">
		{
			heroLines.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
	<div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-2 md:gap-x-3.5">
		{
			heroLines2.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
</h1>

