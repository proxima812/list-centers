---
import { getLocaleFromUrl, useTranslations } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const solidClass = "font-black tracking-tight md:tracking-[-1.4px]";
const gradientClass = `${solidClass} text-transparent bg-clip-text bg-[linear-gradient(120deg,#16a34a,#4ade80,#22c55e,#16a34a)] motion-safe:animate-hero-pulse`;

const heroLines = [
	{ key: "home.hero.1", className: `${solidClass} text-zinc-950` },
	{ key: "home.hero.2", className: gradientClass },
	{ key: "home.hero.3", className: `${solidClass} text-zinc-950/90` },
] as const;

// Неприметный серо-тёмно-серый дрейф. Узкий диапазон оттенков — движение еле заметно.
const grayDriftBase =
	"text-transparent bg-clip-text [background-image:linear-gradient(90deg,#52525b,#27272a,#3f3f46,#18181b,#52525b)] bg-size-[220%_100%] bg-position-[0%_50%] motion-safe:animate-hero-gray-drift";
const grayDriftDim = `${solidClass} ${grayDriftBase} opacity-55`;
const grayDriftStrong = `${solidClass} ${grayDriftBase} opacity-95`;

// Небольшой сдвиг фаз, чтобы слова не мерцали синхронно.
const heroLines2 = [
	{ key: "home.hero.5", className: `${grayDriftDim} [animation-delay:-2s]` },
	{ key: "home.hero.6", className: `${grayDriftStrong} [animation-delay:-6s]` },
	{ key: "home.hero.7", className: `${grayDriftDim} [animation-delay:-10s]` },
] as const;

const titleClass = "uppercase inline-block";
---

<h1 class="relative select-none text-center text-3xl sm:text-5xl md:text-6xl lg:text-7xl">
	<div
		class="flex flex-wrap items-center justify-center md:gap-0 gap-x-2 md:space-x-3.5 md:space-y-2"
	>
		{
			heroLines.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
	<div
		class="flex flex-wrap items-center justify-center md:gap-0 gap-x-2 md:space-x-3.5 md:space-y-2"
	>
		{
			heroLines2.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
</h1>
