---
import { getLocaleFromUrl, useTranslations } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const solidClass = "font-black tracking-tight md:tracking-[-1.4px]";




const heroLines = [
	{ key: "home.hero.1", className: `${solidClass} text-foreground` },
	{
		key: "home.hero.2",
		className: `${solidClass} hero-accent motion-safe:animate-hero-pulse`,
	},
	{ key: "home.hero.3", className: `${solidClass} text-foreground/90` },
] as const;





const heroLines2 = [
	{ key: "home.hero.5", className: `${solidClass} text-muted-foreground` },
	{ key: "home.hero.6", className: `${solidClass} text-foreground` },
	{ key: "home.hero.7", className: `${solidClass} text-muted-foreground` },
] as const;

const titleClass = "uppercase inline-block";
---

{/*
	Размер тянется за шириной, а не прыгает по брейкпоинтам.
	Контейнер — `max-w-5xl`, то есть 984px контента, а «Язык. Культура. Люди.»
	при `text-7xl` занимает 963: на десктопе строка помещается, а на всём, что
	уже 1024px, рвалась — и на телефоне разваливалась на четыре рваные строки
	с одиноким словом посередине. Коэффициент подобран по самой длинной русской
	строке с запасом; верхняя граница 4.5rem — прежний `text-7xl`, поэтому
	десктоп выглядит ровно как раньше. Это роль display из DESIGN.md, она там
	и описана как clamp.
*/}
<h1
	class="relative select-none text-center text-[clamp(1.25rem,calc(7.1vw-3px),4.5rem)] leading-none"
>
	<div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-2 md:gap-x-3.5">
		{
			heroLines.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
	<div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-2 md:gap-x-3.5">
		{
			heroLines2.map(({ key, className }) => (
				<span class:list={[titleClass, className]}>{t(key)}</span>
			))
		}
	</div>
</h1>

<style>
	.hero-accent {
		color: transparent;
		background-clip: text;
		background-image: linear-gradient(
			120deg,
			var(--color-accent-vivid),
			var(--color-accent-glow),
			color-mix(in oklab, var(--color-accent-glow) 70%, var(--color-accent-vivid)),
			var(--color-accent-vivid)
		);
	}
</style>
