---
import printImage from "@/assets/images/print-list-logic-img.png";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { Image } from "astro:assets";

/** Каталог на бумаге: обещание раздела `/centers/print`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
	<div class="space-y-6">
		<h2 class="text-4xl font-bold tracking-tight">{t("home.print.title")}</h2>
		<p class="leading-7 text-muted-foreground">{t("home.print.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.print.text2")}</p>
		<ButtonLink
			href="/centers/print"
			labelKey="nav.print"
			label="Печать .pdf"
			icon="mdi:printer-outline"
			variant="gradient"
		/>
	</div>

	<Image
		src={printImage}
		alt={t("home.print.imageAlt")}
		widths={[400, 640, 768, 1200]}
		sizes="(min-width: 768px) 50vw, 100vw"
		class="w-full rounded-card"
	/>
</section>
