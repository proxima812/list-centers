---
import { getLocaleFromUrl, useTranslations } from "@/i18n";

/**
 * Сколько нас: три числа по народам, по центру страницы.
 *
 * Числа - не оценка и не округление, а строки таблицы 5 Всероссийской
 * переписи населения 2020 года (проведена в 2021-м, Росстат, том 5
 * «Национальный состав и владение языками»). Поэтому и подписи говорят
 * «в России», а не «в мире»: за пределами страны перепись не считает
 * никого, мировые оценки заметно выше и у каждой свой источник.
 *
 * Меняешь число - меняй и ссылку под секцией. Цифра без источника с этой
 * страницы уходит: правило проекта, а не вкус.
 */

const CENSUS_YEAR = 2021;
const CENSUS_HREF = "https://rosstat.gov.ru/vpn/2020/Tom5_Nacionalnyj_sostav_i_vladenie_yazykami";

const STATS = [
	{ key: "tatars", value: 4_713_669 },
	{ key: "bashkirs", value: 1_571_879 },
	{ key: "crimean", value: 257_592 },
];

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const format = new Intl.NumberFormat(locale === "en" ? "en-US" : "ru-RU");
---

<section class="py-4 text-center md:py-8" aria-labelledby="home-people-stats">
	<div class="mx-auto max-w-2xl space-y-4">
		<h2 id="home-people-stats" class="text-4xl font-bold tracking-tight">
			{t("home.people.title")}
		</h2>
		<p class="leading-7 text-muted-foreground">{t("home.people.text")}</p>
	</div>

	<dl
		class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6"
		data-people-stats
	>
		{
			STATS.map((stat) => (
				<div class="space-y-2">
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">
						{t(`home.people.${stat.key}`)}
					</dt>
					<dd
						class="text-4xl font-bold tabular-nums tracking-tight text-accent md:text-5xl"
						data-count-to={stat.value}
					>
						{format.format(stat.value)}
					</dd>
				</div>
			))
		}
	</dl>

	<p class="mt-10 text-xs text-muted-foreground">
		{t("home.people.note", { year: CENSUS_YEAR })}{" "}
		<a
			href={CENSUS_HREF}
			target="_blank"
			rel="noopener noreferrer"
			class="underline decoration-link-decoration underline-offset-2 hover:text-foreground"
		>
			{t("home.people.source")}
		</a>
	</p>
</section>

<script>
	/**
	 * Числа набегают снизу вверх, когда секция попадает в кадр.
	 *
	 * Разметка уже содержит готовое значение — анимация только переписывает
	 * его на время. Без JS, при `prefers-reduced-motion` и в поиске виден
	 * финальный результат, а не ноль.
	 */
	const list = document.querySelector<HTMLElement>("[data-people-stats]");

	if (list && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const cells = [...list.querySelectorAll<HTMLElement>("[data-count-to]")];
		const format = new Intl.NumberFormat(document.documentElement.lang || "ru");
		const DURATION = 1400;

		const write = (progress: number) => {
			// easeOutCubic: быстрый разгон и мягкая остановка на точном числе.
			const eased = progress >= 1 ? 1 : 1 - (1 - progress) ** 3;

			for (const cell of cells) {
				const target = Number(cell.dataset.countTo ?? 0);
				cell.textContent = format.format(Math.round(target * eased));
			}
		};

		const run = () => {
			const started = performance.now();
			write(0);

			const frame = (now: number) => {
				const progress = Math.min(1, (now - started) / DURATION);
				write(progress);

				if (progress < 1) requestAnimationFrame(frame);
			};

			requestAnimationFrame(frame);
			// Вкладка может уйти в фон и заморозить кадры на середине отсчёта:
			// возвращаемся — показываем итог, а не случайное промежуточное число.
			document.addEventListener("visibilitychange", () => {
				if (document.hidden) return;
				if (performance.now() - started >= DURATION) write(1);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.disconnect();
					run();
				}
			},
			{ threshold: 0.35 },
		);

		observer.observe(list);
	}
</script>
