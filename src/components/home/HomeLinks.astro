---
import { links } from "@/data/links";
import { getCollection } from "astro:content";
import ButtonLink from "../ui/ButtonLink.astro";

const centersCount = (await getCollection("centers")).length;
const centersLink = links.find((item) => item.href === "/centers");
---

<section>
	<div class="flex gap-1.5 justify-center flex-wrap items-center">
		{
			centersLink && (
				<ButtonLink
					{...centersLink}
					labelKey="nav.viewCenters"
					badge={centersCount}
					variant="gradient"
					class="md:px-4 md:py-2 md:text-sm text-base"
				/>
			)
		}
		<ButtonLink
			href="/nearby"
			labelKey="nav.nearby"
			label="Центры рядом"
			icon="mdi:map-marker-radius-outline"
			variant="outline"
			class="md:px-4 md:py-2 md:text-sm text-base"
		/>
	</div>
</section>
