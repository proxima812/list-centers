---
import savedImage from "@/assets/images/save-logic-img.png";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { Image } from "astro:assets";

/** Сохранённые центры: обещание раздела `/saved`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12">
	<div class="order-2 space-y-6">
		<h2 class="text-4xl font-bold tracking-tight">{t("home.saved.title")}</h2>
		<p class="leading-7 text-muted-foreground">{t("home.saved.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.saved.text2")}</p>
		<ButtonLink
			href="/saved"
			labelKey="saved.title"
			label="Сохраненные"
			icon="tabler:bookmark"
			variant="gradient"
		/>
	</div>

	<Image
		src={savedImage}
		alt={t("home.saved.imageAlt")}
		widths={[400, 640, 768, 1200]}
		sizes="(min-width: 768px) 50vw, 100vw"
		class="order-1 w-full rounded-card"
	/>
</section>
