---
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";

interface Props {
	id: string;
	href: string;
	title: string;
	description: string;
	author: string;
	pubDate: Date;
	publishedDate?: Date;
	modifiedDate?: Date;
	relativeTime: string;
	fullDate: string;
	publishedLabel?: string;
	modifiedLabel?: string;
	isLong?: boolean;
}

const {
	id,
	href,
	title,
	description,
	author,
	pubDate,
	publishedDate,
	modifiedDate,
	relativeTime,
	fullDate,
	publishedLabel,
	modifiedLabel,
	isLong,
} = Astro.props as Props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const postHref = localizePath(locale, href);
---

<article
	id={id}
	class="group relative scroll-mt-24 overflow-hidden rounded-catalog corner-squircle bg-linear-to-br from-surface via-surface to-surface-muted/70 p-5 text-surface-foreground shadow-2xs ring ring-depth-100 transition duration-300 ease-out hover:-translate-y-0.5 hover:ring-depth-200 hover:shadow-sm sm:p-6"
>
	<header>
		<div class="flex flex-wrap items-center gap-2 text-xs leading-5">
			<span class="rounded-full bg-background px-2.5 py-1 font-medium text-muted-foreground ring ring-depth-100">
				{author}
			</span>
			<time
				class="rounded-full bg-background px-2.5 py-1 font-medium tabular-nums text-muted-foreground ring ring-depth-100"
				datetime={pubDate.toISOString()}
				title={fullDate}
			>
				{relativeTime}
			</time>
			<time
				class="text-muted-foreground"
				datetime={pubDate.toISOString()}
			>
				{fullDate}
			</time>
		</div>

		<h2 class="mt-4 text-xl font-bold leading-tight tracking-tight text-foreground sm:text-2xl">
			<a href={postHref} class="wrap-anywhere rounded-micro no-underline transition hover:text-depth-700">
				{title}
			</a>
		</h2>

		<p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
			{description}
		</p>
	</header>

	<div class="mt-5 rounded-card corner-squircle bg-background/85 p-4 ring ring-depth-100 transition group-hover:ring-depth-200 sm:p-5">
		<div
			class:list={[
				"prose prose-sm max-w-none text-depth-600 sm:prose-base prose-p:my-2 prose-a:font-medium prose-a:text-link prose-a:decoration-link-decoration prose-a:underline-offset-4 prose-blockquote:my-3 first:prose-p:mt-0 last:prose-p:mb-0",
				isLong && "line-clamp-5",
			]}
		>
			<slot />
		</div>

		<a
			href={postHref}
			class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1.5 text-sm font-medium text-muted-foreground no-underline ring ring-depth-100 transition hover:bg-primary hover:text-primary-foreground"
		>
			<span>{t("posts.read")}</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4"
				aria-hidden="true"
			>
				<path d="M5 12h14" />
				<path d="m12 5 7 7-7 7" />
			</svg>
			<span class="sr-only">: {title}</span>
		</a>
	</div>

	<footer class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.72rem] leading-5 text-muted-foreground">
		{
			publishedLabel && (
				<time datetime={publishedDate?.toISOString()}>
					{t("content.published")}: {publishedLabel}
				</time>
			)
		}
		{publishedLabel && modifiedLabel && <span class="hidden sm:inline" aria-hidden="true">·</span>}
		{
			modifiedLabel && (
				<time datetime={modifiedDate?.toISOString()}>
					{t("content.updated")}: {modifiedLabel}
				</time>
			)
		}
	</footer>
</article>
