---
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import type { PostEntry } from "@/lib/post/collection";
import { getPostPath } from "@/lib/post/posts";
import { Icon } from "astro-icon/components";

interface Props {
	newerPost: PostEntry | null;
	olderPost: PostEntry | null;
}

const { newerPost, olderPost } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const neighbours = [
	newerPost ? { post: newerPost, label: t("posts.newer"), icon: "tabler:arrow-left" } : null,
	olderPost ? { post: olderPost, label: t("posts.older"), icon: "tabler:arrow-right" } : null,
].filter((item): item is NonNullable<typeof item> => Boolean(item));
---

{
	neighbours.length > 0 && (
		<nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label={t("posts.neighbours")}>
			{neighbours.map((item) => (
				<a
					href={localizePath(locale, getPostPath(item.post.id))}
					class="group flex min-w-0 flex-col gap-1 rounded-card corner-squircle bg-surface p-4 text-left no-underline ring ring-depth-100 transition hover:ring-depth-200"
				>
					<span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
						<Icon name={item.icon} class="size-3.5 shrink-0" aria-hidden="true" />
						{item.label}
					</span>
					<span class="min-w-0 text-sm font-semibold wrap-anywhere text-foreground sm:text-base">
						{item.post.data.title}
					</span>
				</a>
			))}
		</nav>
	)
}
