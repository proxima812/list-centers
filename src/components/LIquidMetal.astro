---
import LiquidMetalMark from "./LiquidMetalMark.tsx";
---

<div
	aria-hidden="true"
	data-liquid-metal
	class="liquid-metal pointer-events-none -mb-0 relative grid h-[140px] w-[140px] place-items-center overflow-hidden mx-auto"
>
	<img
		src="/flower.svg"
		alt="Логотип Tatarverse"
		loading="eager"
		class="flower-fade absolute z-50 h-[84px] w-[84px] object-contain"
	/>

	<LiquidMetalMark client:media="(prefers-reduced-motion: no-preference)" />
</div>

<style>
	.flower-fade {
		opacity: 1;
	}

	.webgl-ready .flower-fade {
		animation: flower-fade-out 600ms ease-out forwards;
	}

	@keyframes flower-fade-out {
		to {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flower-fade {
			animation: none;
		}
	}
</style>
