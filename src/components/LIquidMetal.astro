---
import LiquidMetalMark from "./LiquidMetalMark.tsx";

interface Props {
	size?: number;
	class?: string;
}

const { size = 140, class: className } = Astro.props;

// Марка занимает 60% холста — тот же запас под растекание шейдера, что был
// при жёстких 140/84. Размер приходит пропом, поэтому едет через CSS-переменные:
// в Tailwind произвольные значения статичны и на пропе не собираются.
const markSize = Math.round(size * 0.6);
---

<div
	aria-hidden="true"
	data-liquid-metal
	class:list={[
		"liquid-metal pointer-events-none relative grid shrink-0 place-items-center overflow-hidden",
		className,
	]}
	style={`--lm-size:${size}px;--lm-mark:${markSize}px`}
>
	<img
		src="/flower.svg"
		alt="Логотип Tatarverse"
		loading="eager"
		class="flower-fade absolute z-50 object-contain"
	/>

	<span class="flower-solid absolute z-50" aria-hidden="true"></span>

	<LiquidMetalMark size={size} client:media="(prefers-reduced-motion: no-preference)" />
</div>

<style>
	.liquid-metal {
		height: var(--lm-size);
		width: var(--lm-size);
	}

	.flower-fade,
	.flower-solid {
		height: var(--lm-mark);
		width: var(--lm-mark);
	}

	.flower-fade {
		opacity: 1;
	}

	.webgl-ready .flower-fade {
		animation: flower-fade-out 600ms ease-out forwards;
	}

	@keyframes flower-fade-out {
		to {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flower-fade {
			animation: none;
		}
	}

	/* Статичный дубль марки для выключенных анимаций: та же форма, но залитая
	   акцентом темы, а не шейдером. Маска, а не <img>: цветок в flower.svg со
	   своей палитрой, а здесь нужен один тон, который следует за палитрой. */
	.flower-solid {
		display: none;
		background-color: var(--color-accent-vivid);
		mask: url("/flower.svg") center / contain no-repeat;
		-webkit-mask: url("/flower.svg") center / contain no-repeat;
	}

	:global([data-motion="off"]) .flower-solid {
		display: block;
	}

	:global([data-motion="off"]) .flower-fade {
		display: none;
	}
</style>
