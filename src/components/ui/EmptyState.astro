---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

/**
 * Пустой экран страницы: иконка, заголовок, подсказка и выход в каталог.
 * Общий для `/saved` и `/nearby`; заголовок отдаётся слотом, потому что на
 * `/nearby` его подставляет скрипт, а на `/saved` он статический.
 */
interface Props extends HTMLAttributes<"section"> {
	icon: string;
	hint: string;
	actionHref: string;
	actionLabel: string;
}

const {
	icon,
	hint,
	actionHref,
	actionLabel,
	class: className,
	...attrs
} = Astro.props as Props;
---

<section
	{...attrs}
	class:list={[
		"flex min-w-0 flex-col items-center gap-4 rounded-catalog corner-squircle bg-surface px-6 py-16 text-center text-surface-foreground",
		className,
	]}
>
	<Icon name={icon} class="size-8 shrink-0 text-subtle-foreground" aria-hidden="true" />
	<slot name="title" />
	<p class="max-w-md text-sm leading-6 text-muted-foreground">{hint}</p>
	<a
		href={actionHref}
		class="inline-flex items-center gap-2 rounded-full corner-squircle border border-border px-4 py-2 text-sm font-medium text-muted-foreground no-underline transition hover:bg-muted hover:text-foreground"
	>
		{actionLabel}
	</a>
</section>
