---
import { cardDataset, cardPart } from "@/lib/site/cardAttributes";
import { normalizeCity, type CenterGeo } from "@/data/geo";
import { countryFlagsByRu, getCountryLabel } from "@/data/worldCountries";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { formatCenterLinkLabel, type CenterLink } from "@/lib/center/links";
import { getCenterMarkHue, getCenterPath } from "@/lib/center/centers";
import { Icon } from "astro-icon/components";
import SaveCenterButton from "./SaveCenterButton.astro";

interface Location {
	flag?: string;
	city?: string;
	country?: string;
}

interface Props {
	id: string;
	routeId?: string;
	title?: string;
	summary?: string;
	type?: string;
	category?: string;
	location?: Location;
	region?: string;
	geo?: CenterGeo;
	pubDate?: string;
	links?: CenterLink[];
	/**
	 * Режим заготовки для `<template>` на `/saved`: все необязательные блоки
	 * рендерятся пустыми, чтобы клиенту было куда подставить значения.
	 * Иначе пришлось бы держать вторую копию разметки карточки.
	 */
	template?: boolean;
}

const {
	id,
	routeId,
	title,
	summary,
	type,
	category,
	location,
	region,
	geo,
	pubDate,
	links,
	template = false,
} = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const centerPath = getCenterPath(routeId ?? id);

const cleanCity = geo ? geo.city || undefined : normalizeCity(location?.city);
const cleanCountry = geo ? geo.country || undefined : location?.country?.trim() || undefined;
const cleanRegion = geo ? geo.region : (region ?? "");
const cleanFlag =
	location?.flag?.trim() || (cleanCountry ? countryFlagsByRu[cleanCountry] : undefined);
const displayCountry = cleanCountry ? getCountryLabel(cleanCountry, locale) : undefined;
const countryKey = cleanCountry ?? "Прочее";
const displayTitle = title ?? "—";
const displaySummary = summary?.trim();
const displayLocation =
	cleanFlag || cleanCity || displayCountry
		? { flag: cleanFlag, city: cleanCity, country: displayCountry }
		: null;
const formattedDate =
	pubDate &&
	!Number.isNaN(new Date(pubDate).getTime()) &&
	new Intl.DateTimeFormat(locale, { month: "short", year: "numeric" }).format(
		new Date(pubDate),
	);

const metaChipClass =
	"inline-flex min-w-0 items-center rounded-micro corner-squircle bg-surface-muted px-2 py-1";
const quickLinkClass =
	"relative z-10 inline-flex min-w-0 items-center gap-1 text-xs font-medium text-muted-foreground no-underline transition hover:text-foreground";
const viewButtonClass =
	"ml-auto inline-flex shrink-0 items-center gap-1 rounded-full corner-squircle bg-surface-muted px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors duration-300 ease-out group-hover:bg-accent group-hover:text-accent-foreground";
const quickLinks = links ?? [];

// Единственное место, где карточка объявляет свой DOM-контракт. Имена
// атрибутов — в @/lib/site/cardAttributes, там же их читают фильтры и /saved.
const dataset = cardDataset({
	id,
	scope: geo?.scope ?? "",
	macro: geo?.macro ?? "",
	okrug: geo?.okrug ?? "",
	country: countryKey,
	region: cleanRegion,
	city: cleanCity ?? "",
	type: type ?? "",
	category: category ?? "",
	title: displayTitle,
	summary: summary ?? "",
	flag: cleanFlag ?? "",
	pubDate: pubDate ?? "",
	href: centerPath,
});
---

<article
	{...dataset}
	class="group relative flex h-full min-w-0 flex-col gap-3 rounded-catalog corner-squircle bg-surface p-6 text-surface-foreground transition duration-300 ease-out hover:surface-lift has-[[data-card-link]:focus-visible]:outline-2 has-[[data-card-link]:focus-visible]:outline-offset-2 has-[[data-card-link]:focus-visible]:outline-accent"
>
	<slot name="action"><SaveCenterButton title={displayTitle} /></slot>

	{
		(template || displayLocation) && (
			<p
				{...cardPart("location", template)}
				class:list={[
					"flex min-w-0 flex-wrap items-center gap-1.5 text-xs text-muted-foreground",
					template ? "pr-24" : "pr-9",
				]}
			>
				{(template || displayLocation?.flag) && (
					<span {...cardPart("flag", template)} class="shrink-0 text-base leading-none">
						{displayLocation?.flag}
					</span>
				)}
				{(template || displayLocation?.city) && (
					<span {...cardPart("city", template)}>{displayLocation?.city}</span>
				)}
				{(template || (displayLocation?.city && displayLocation?.country)) && (
					<span {...cardPart("separator", template)} aria-hidden="true">
						&#10625;
					</span>
				)}
				{(template || displayLocation?.country) && (
					<span {...cardPart("country", template)}>{displayLocation?.country}</span>
				)}
			</p>
		)
	}
	<div class="flex min-w-0 items-center gap-3">
		<span
			{...cardPart("mark", template)}
			class="center-mark size-9 shrink-0 rounded-full transition-transform duration-300 ease-out group-hover:scale-110"
			style={template ? undefined : `--mark-hue:${getCenterMarkHue(id)}`}
			aria-hidden="true"></span>
		<h2
			{...cardPart("heading", template)}
			class:list={[
				"min-w-0 wrap-anywhere font-bold leading-snug tracking-tight",
				!template && !displayLocation && "pr-9",
			]}
		>
			<a
				data-card-link
				href={template ? "#" : localizePath(locale, centerPath)}
				class="text-surface-foreground no-underline before:absolute before:inset-0 before:rounded-catalog before:content-[''] focus-visible:outline-hidden"
			>
				{displayTitle}
			</a>
		</h2>
	</div>

	{
		(template || displaySummary) && (
			<p {...cardPart("summary", template)} class="line-clamp-2 text-sm leading-6 text-muted-foreground">
				{displaySummary}
			</p>
		)
	}
	<p
		class="mt-auto flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 pt-1 text-xs text-muted-foreground"
	>
		{
			(template || category) && (
				<span
					{...cardPart("category", template)}
					class={`${metaChipClass} font-semibold text-surface-foreground`}
				>
					{category}
				</span>
			)
		}
		{(template || type) && (
			<span {...cardPart("type", template)} class={metaChipClass}>
				{type}
			</span>
		)}
		{
			(template || formattedDate) && (
				<span
					{...cardPart("date", template)}
					class="ml-auto shrink-0 tabular-nums text-subtle-foreground"
				>
					{formattedDate}
				</span>
			)
		}
	</p>
	{
		/* У сохранённой карточки нет ни быстрых ссылок, ни кнопки «Подробнее»:
		   в localStorage их не кладут, а вся карточка и так ведёт на центр. */
		!template && (
			<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5 pt-1">
				{quickLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noopener noreferrer" class={quickLinkClass}>
						<Icon name={link.icon} class="size-3.5 shrink-0" aria-hidden="true" />
						<span class="min-w-0 truncate">{formatCenterLinkLabel(link.href)}</span>
						<span class="sr-only">
							{" "}
							— {link.label}: {displayTitle}
						</span>
					</a>
				))}
				<span class={viewButtonClass} aria-hidden="true">
					<span>{t("card.details")}</span>
					<Icon name="mdi:arrow-right" class="size-3.5 shrink-0" />
				</span>
			</div>
		)
	}
</article>
