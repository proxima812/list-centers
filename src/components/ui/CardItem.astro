---
import { normalizeCity, type CenterGeo } from "@/data/geo";
import { countryFlagsByRu, getCountryLabel, getCountryLabels } from "@/data/worldCountries";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { getCenterPath } from "@/utils/centers";
import { formatCenterLinkLabel, type CenterLink } from "@/utils/centerLinks";
import { Icon } from "astro-icon/components";
import SaveCenterButton from "./SaveCenterButton.astro";

interface Location {
	flag?: string;
	city?: string;
	country?: string;
}

interface Props {
	id: string;
	routeId?: string;
	title?: string;
	summary?: string;
	type?: string;
	category?: string;
	location?: Location;
	region?: string;
	/**
	 * Нормализованная география из `src/data/geo`. Когда она есть, карточка
	 * берёт значения фильтров из неё, а не из сырого frontmatter: ключ фасета
	 * и ключ карточки обязаны совпадать, иначе фильтр не находит свои же
	 * карточки. Без неё компонент работает по-старому — так его зовут связанные
	 * центры на странице центра.
	 */
	geo?: CenterGeo;
	pubDate?: string;
	links?: CenterLink[];
}

const { id, routeId, title, summary, type, category, location, region, geo, pubDate, links } =
	Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const centerPath = getCenterPath(routeId ?? id);

const cleanCity = geo ? geo.city || undefined : normalizeCity(location?.city);
const cleanCountry = geo ? geo.country || undefined : location?.country?.trim() || undefined;
const cleanRegion = geo ? geo.region : (region ?? "");
const cleanFlag =
	location?.flag?.trim() || (cleanCountry ? countryFlagsByRu[cleanCountry] : undefined);
const displayCountry = cleanCountry ? getCountryLabel(cleanCountry, locale) : undefined;
const countryKey = cleanCountry ?? "Прочее";
const countryLabels = cleanCountry ? getCountryLabels(cleanCountry) : undefined;
const displayTitle = title ?? "—";
const displaySummary = summary?.trim();
const displayLocation =
	cleanFlag || cleanCity || displayCountry
		? { flag: cleanFlag, city: cleanCity, country: displayCountry, countryLabels }
		: null;
const formattedDate =
	pubDate &&
	!Number.isNaN(new Date(pubDate).getTime()) &&
	new Intl.DateTimeFormat(locale, { month: "short", year: "numeric" }).format(
		new Date(pubDate),
	);

// Категория и тип — тихая мета, но на ровном фоне карточки она сливалась с
// описанием. Отделяет её слой на ступень глубже — одной заливкой
// `surface-muted`, без кольца: `corner-squircle` и box-shadow-кольцо режут
// углы по-разному, и обводка на скруглении выглядит приклеенной.
const metaChipClass =
	"inline-flex min-w-0 items-center rounded-micro corner-squircle bg-surface-muted px-2 py-1";
// Быстрые ссылки лежат над растянутой ссылкой карточки, поэтому им нужен свой
// слой по z: иначе перекрытие съедает клик и с сайта центра уводит на страницу
// центра.
//
// Пилюли у ссылок сняты. Подписью стал сам адрес, а он длиннее слова
// «Instagram» — три залитых плашки с адресами внутри карточки читались бы
// вторым списком, а не сноской. Ссылку держит иконка площадки и цвет.
const quickLinkClass =
	"relative z-10 inline-flex min-w-0 items-center gap-1 text-xs font-medium text-muted-foreground no-underline transition hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
// «Смотреть» — не ссылка, а подсказка: вся карточка и так кликабельна, и
// вторая ссылка на тот же адрес удвоила бы её в списке ссылок скринридера и
// в порядке табуляции. Поэтому span, `aria-hidden` и никакого z-слоя: клик
// проваливается на растянутую ссылку заголовка, которая лежит ниже.
const viewButtonClass =
	"ml-auto inline-flex shrink-0 items-center gap-1 rounded-full corner-squircle bg-surface-muted px-2.5 py-1 text-xs font-medium text-muted-foreground transition group-hover:bg-accent group-hover:text-accent-foreground";
const quickLinks = links ?? [];
---

{
	/*
	Одна обводка на уровень вложенности. Раньше внутри кольца карточки жили
	ещё четыре кольца — пилюля «Подробнее», сегментированная пара тип/категория
	и капсула даты, — и все элементы читались одинаково важными. Мета осталась
	той же, но держится типографикой: заголовок жирный, остальное тихое.

	Подъём тратится только на ховер: 340 карточек с тенью в покое — это шум и
	композитинг без пользы. Кликабельна вся карточка, поэтому наведение
	поднимает её целиком. Кольца в покое нет: от фона каталога карточку
	отделяет собственная заливка, а обводка на squircle-углах не совпадает
	с их формой. На ховере к подъёму добавляется `card-ring` — акцентное
	градиентное кольцо с бегущей дугой; оно рисуется маской по форме
	squircle и живёт только под курсором, по тому же счёту, что и тень.
	Подчёркивания у заголовка нет:
	оно делало вид, что кликабелен один h2, хотя цель — весь блок.

	Карточка больше не обёрнута в `<a>`: внизу появились быстрые ссылки на сайт
	и соцсети, а ссылка внутри ссылки невалидна и ломает клик. Вместо этого
	ссылка на страницу центра растянута псевдоэлементом на всю карточку
	(`before:absolute before:inset-0`), а быстрые ссылки лежат над ней по z.
	Заголовок остаётся текстом ссылки, поэтому в списке ссылок скринридера
	карточка называет себя осмысленно.

	Часть data-атрибутов ниже поставил поиск с фильтрами (title, summary, city,
	country, type, category); закладка дописала к ним flag, pub-date и href.
	Вместе это ровно тот снимок, который уходит в localStorage и из которого
	/saved рисует карточку, не поднимая каталог. Страна берётся русская:
	/saved — одна страница на обе локали, в дефолтной.
*/
}
<article
	data-type={type ?? ""}
	data-category={category ?? ""}
	data-country={countryKey}
	data-search-id={id}
	data-title={displayTitle}
	data-summary={summary ?? ""}
	data-city={cleanCity ?? ""}
	data-region={cleanRegion}
	data-macro={geo?.macro ?? ""}
	data-okrug={geo?.okrug ?? ""}
	data-scope={geo?.scope ?? ""}
	data-flag={cleanFlag ?? ""}
	data-pub-date={pubDate ?? ""}
	data-href={centerPath}
	class="group card-ring relative flex h-full min-w-0 flex-col gap-3 rounded-catalog corner-squircle bg-surface p-6 text-surface-foreground transition hover:surface-lift has-[[data-card-link]:focus-visible]:outline-2 has-[[data-card-link]:focus-visible]:outline-offset-2 has-[[data-card-link]:focus-visible]:outline-primary"
>
	<SaveCenterButton title={displayTitle} />
	{
		displayLocation && (
			<p class="flex min-w-0 flex-wrap items-center gap-1.5 pr-9 text-xs text-muted-foreground">
				{displayLocation.flag && (
					<span class="shrink-0 text-base leading-none">{displayLocation.flag}</span>
				)}
				{/* {displayLocation.city && <span>{truncate(displayLocation.city.trim(), 16)}</span>} */}
				{displayLocation.city && <span>{displayLocation.city}</span>}
				{displayLocation.city && displayLocation.countryLabels && (
					<span aria-hidden="true">&#10625;</span>
				)}
				{displayLocation.countryLabels && (
					<span
						data-country-label={cleanCountry}
						data-country-labels={JSON.stringify(displayLocation.countryLabels)}
					>
						{displayLocation.country}
					</span>
				)}
			</p>
		)
	}
	<h2
		class:list={[
			"min-w-0 wrap-anywhere font-bold leading-snug tracking-tight",
			// Без строки локации заголовок оказывается первым и подъезжает под
			// закладку. Отступ ставим только в этом случае: у карточек с локацией
			// место под кнопку освобождает она.
			!displayLocation && "pr-9",
		]}
	>
		<a
			data-card-link
			href={localizePath(locale, centerPath)}
			class="text-surface-foreground no-underline before:absolute before:inset-0 before:rounded-catalog before:content-[''] focus-visible:outline-hidden"
		>
			{displayTitle}
		</a>
	</h2>
	{
		displaySummary && (
			<p class="line-clamp-2 text-sm leading-6 text-muted-foreground">{displaySummary}</p>
		)
	}
	<p
		class="mt-auto flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 pt-1 text-xs text-muted-foreground"
	>
		{
			category && (
				<span class={`${metaChipClass} font-semibold text-surface-foreground`}>
					{category}
				</span>
			)
		}
		{type && <span class={metaChipClass}>{type}</span>}
		{
			formattedDate && (
				<span class="ml-auto shrink-0 tabular-nums text-subtle-foreground">
					{formattedDate}
				</span>
			)
		}
	</p>
	<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5 pt-1">
		{
			quickLinks.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer" class={quickLinkClass}>
					<Icon name={link.icon} class="size-3.5 shrink-0" aria-hidden="true" />
					<span class="min-w-0 truncate">{formatCenterLinkLabel(link.href)}</span>
					{/* Видимая подпись — адрес, а вслух нужна площадка и название центра. */}
					<span class="sr-only"> — {link.label}: {displayTitle}</span>
				</a>
			))
		}
		<span class={viewButtonClass} aria-hidden="true">
			<span>{t("card.details")}</span>
			<Icon name="mdi:arrow-right" class="size-3.5 shrink-0" />
		</span>
	</div>
</article>
