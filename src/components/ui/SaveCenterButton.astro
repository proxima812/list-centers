---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/utils/libs/cn";
import { Icon } from "astro-icon/components";

interface Props {
	title?: string;
	class?: string;
}

const { title, class: className } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const suffix = title ? `: ${title}` : "";
const saveLabel = `${t("saved.save")}${suffix}`;
const removeLabel = `${t("saved.remove")}${suffix}`;
---

<button
	type="button"
	data-save-center
	data-label-save={saveLabel}
	data-label-remove={removeLabel}
	aria-pressed="false"
	aria-label={saveLabel}
	title={saveLabel}
	class={cn(
		"save-center absolute right-3 top-3 z-10 inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-subtle-foreground transition-colors hover:bg-surface-muted hover:text-foreground aria-pressed:text-favorite aria-pressed:hover:text-favorite",
		className,
	)}
>
	<Icon name="tabler:bookmark" class="save-center-off size-5" aria-hidden="true" />
	<Icon name="tabler:bookmark-filled" class="save-center-on size-5" aria-hidden="true" />
</button>

<style>
	.save-center-on,
	[aria-pressed="true"] .save-center-off {
		display: none;
	}

	[aria-pressed="true"] .save-center-on {
		display: block;
	}

	.save-center:active {
		transform: scale(0.88);
	}
</style>

<script>
	import { initSavedCenters } from "@/scripts/savedCentersUi";

	initSavedCenters();
</script>
