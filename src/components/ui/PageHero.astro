---
/**
 * Шапка простой страницы: заголовок, вводный абзац и слот под управление
 * (чипы, селекты, строка статуса). Одна разметка на `/nearby` и `/saved` -
 * до этого она была скопирована в обе страницы и уже начала расходиться.
 */
interface Props {
	title: string;
	intro?: string;
	class?: string;
}

const { title, intro, class: className } = Astro.props as Props;
---

<section class:list={["flex min-w-0 flex-col gap-4", className]}>
	<h1 class="text-3xl font-bold tracking-[-0.03em] text-foreground sm:text-4xl">{title}</h1>
	{intro && <p class="max-w-3xl text-base leading-7 text-muted-foreground">{intro}</p>}
	<slot />
</section>
