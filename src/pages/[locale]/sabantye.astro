---
import { defaultLocale, locales } from "@/i18n";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.map((locale) => ({ params: { locale } }));
}

// Перевода нет: страница сабантуя одна на обе локали и живет по /sabantye/.
// Заглушка нужна только для старых внешних ссылок на /en/sabantye/.
return Astro.redirect("/sabantye/", 301);
---
