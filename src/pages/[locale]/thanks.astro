---
import { defaultLocale, locales } from "@/i18n";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.map((locale) => ({ params: { locale } }));
}

// Перевода нет: страница благодарностей целиком русская, EN-копия
// отдавала тот же текст с lang="en".
return Astro.redirect("/thanks/", 301);
---
