---
import { getCenterTranslationCollection, createCenterRouteIdMap } from "@/utils/centers";
import { secondaryLocales } from "@/i18n/routes";
import { collectionFingerprint } from "@/utils/cacheKey";
import { getCollection } from "astro:content";
import CenterPage from "../../centers/[id].astro";

export async function getStaticPaths() {
	const entries = await getCollection("centers");
	const routeIds = createCenterRouteIdMap(entries);
	const cacheKey = collectionFingerprint([...entries, ...(await getCollection("centersEn"))]);

	const translationsByLocale = new Map(
		await Promise.all(
			secondaryLocales().map(async (locale) => {
				const collection = getCenterTranslationCollection(locale);
				const translated = collection ? await getCollection(collection) : [];

				return [locale, new Map(translated.map((entry) => [entry.id, entry]))] as const;
			}),
		),
	);

	// Локализованная страница центра существует только там, где есть перевод:
	// подставлять русский текст под /en/ нельзя — canonical и hreflang врут.
	return secondaryLocales().flatMap((locale) =>
		entries.flatMap((entry) => {
			const localizedEntry = translationsByLocale.get(locale)?.get(entry.id);
			if (!localizedEntry) return [];

			return [
				{
					params: { locale, id: routeIds.get(entry.id) ?? entry.id },
					props: { entry, localizedEntry },
					cacheKey,
				},
			];
		}),
	);
}
---

<CenterPage entry={Astro.props.entry} localizedEntry={Astro.props.localizedEntry} />
