---
import { byNewest, localizedPosts } from "@/lib/post/collection";
import { secondaryLocales } from "@/i18n/routes";
import { getPostId } from "@/lib/post/posts";
import { entryFingerprint, pageCacheKey } from "@/lib/build/cacheKey";
import PostPage from "../../posts/[id].astro";

export async function getStaticPaths() {
	const byLocale = await Promise.all(
		secondaryLocales().map(async (locale) => {
			const posts = byNewest(await localizedPosts(locale));

			return posts.map((post, index) => {
				const newerPost = index > 0 ? posts[index - 1] : null;
				const olderPost = index < posts.length - 1 ? posts[index + 1] : null;

				return {
					params: { locale, id: getPostId(post.id) },
					props: { post, newerPost, olderPost },
					cacheKey: pageCacheKey(
						entryFingerprint(post),
						newerPost && entryFingerprint(newerPost),
						olderPost && entryFingerprint(olderPost),
					),
				};
			});
		}),
	);

	return byLocale.flat();
}
---

<PostPage
	post={Astro.props.post}
	newerPost={Astro.props.newerPost}
	olderPost={Astro.props.olderPost}
/>
