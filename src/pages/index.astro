---
import HomeHeroBadge from "@/components/home/HomeHeroBadge.astro";
import HomeHeroTitle from "@/components/home/HomeHeroTitle.astro";
import HomeLinks from "@/components/home/HomeLinks.astro";
import HomeSections from "@/components/home/HomeSections.astro";
import { catalogStats } from "@/domain/center/stats";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const {
	count: centers,
	countries: countriesCount,
	regions: regionsCount,
} = catalogStats(await getCollection("centers"));
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout
	title={t("home.meta.title")}
	description={t("home.meta.description")}
	markdownURL="/index.md"
	keywords={[
		"ТБК",
		"татары",
		"башкиры",
		"крымские татары",
		"татарские центры",
		"башкирские центры",
		"крымскотатарские центры",
		"культурные центры",
		`${centers} центров`,
		`${countriesCount} стран`,
		`${regionsCount} регионов`,
	]}
>
	<main class="space-y-12">
		<div class="space-y-5">
			<HomeHeroBadge />
			<HomeHeroTitle />
		</div>
		<div>
			<HomeLinks />
		</div>

		<HomeSections />
	</main>
</Layout>
