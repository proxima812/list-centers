---
import HomeFollowersCarousel from "@/components/home/HomeFollowersCarousel.astro";
import HomeHeroBadge from "@/components/home/HomeHeroBadge.astro";
import HomeHeroTitle from "@/components/home/HomeHeroTitle.astro";
import HomeLinks from "@/components/home/HomeLinks.astro";
import HomeSections from "@/components/home/HomeSections.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const allCenters = await getCollection("centers");
const centers = allCenters.length;
const countriesCount = new Set(
	allCenters.map((center) => center.data.location?.country).filter(Boolean),
).size;
const regionsCount = new Set(
	allCenters.map((center) => center.data.location?.region).filter(Boolean),
).size;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout
	title={t("home.meta.title")}
	description={t("home.meta.description")}
	markdownURL="/index.md"
	keywords={[
		"ТБК",
		"татары",
		"башкиры",
		"крымские татары",
		"татарские центры",
		"башкирские центры",
		"крымскотатарские центры",
		"культурные центры",
		`${centers} центров`,
		`${countriesCount} стран`,
		`${regionsCount} регионов`,
	]}
>
	<main class="space-y-12">
		<div class="space-y-5">
			<HomeHeroBadge />
			<HomeHeroTitle />
		</div>
		<div>
			<HomeLinks />
		</div>

		<!-- <HomeFollowersCarousel /> -->

		<HomeSections />
	</main>
</Layout>
