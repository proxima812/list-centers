---
import SavedBoard from "@/components/saved/SavedBoard.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout
	title={t("saved.title")}
	description={t("saved.description")}
	indexRobots={false}
	classContainer="max-w-7xl"
>
	<SavedBoard />
</Layout>
