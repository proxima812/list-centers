---
import { markdownComponents } from "@/components/markdown/markdownComponents";
import SkipNode from "@/components/markdown/SkipNode.astro";
import BackButton from "@/components/navigation/BackButton.astro";
import PostHeader from "@/components/posts/PostHeader.astro";
import PostNeighbours from "@/components/posts/PostNeighbours.astro";
import PostTags from "@/components/posts/PostTags.astro";
import ContentDates from "@/components/ui/ContentDates.astro";
import { defaultLocale, getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { entryFingerprint, pageCacheKey } from "@/lib/build/cacheKey";
import { getContentDates } from "@/lib/contentDates";
import { byNewest, type PostEntry } from "@/lib/post/collection";
import { getPostId, getPostMarkdownPath, getPostPath } from "@/lib/post/posts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = byNewest(await getCollection("posts"));

	return posts.map((post, index) => {
		const newerPost = index > 0 ? posts[index - 1] : null;
		const olderPost = index < posts.length - 1 ? posts[index + 1] : null;

		return {
			params: { id: getPostId(post.id) },
			props: { post, newerPost, olderPost },
			// Пост зависит только от себя и двух соседних ссылок.
			cacheKey: pageCacheKey(
				entryFingerprint(post),
				newerPost && entryFingerprint(newerPost),
				olderPost && entryFingerprint(olderPost),
			),
		};
	});
}

interface Props {
	post: PostEntry;
	newerPost: PostEntry | null;
	olderPost: PostEntry | null;
}

const { post, newerPost, olderPost } = Astro.props as Props;
const { Content } = await render(post);
const data = post.data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const isDefault = locale === defaultLocale;

const { publishedDate, modifiedDate } = getContentDates({
	pubDate: data.pubDate,
	filePath: post.filePath,
});

const fullDate = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "Asia/Almaty",
})
	.format(data.pubDate)
	.replace(/\s?г\.$/, "");
---

<Layout
	title={data.title}
	description={data.description}
	type="article"
	canonicalURL={localizePath(locale, getPostPath(post.id))}
	keywords={["tatarverse", t("posts.title"), data.category, ...data.tags]}
	ogImage={data.ogImage}
	rssURL={isDefault ? "/posts/rss.xml" : undefined}
	markdownURL={isDefault ? getPostMarkdownPath(post.id) : undefined}
	datePublished={publishedDate}
	dateModified={modifiedDate}
>
	<BackButton href="/posts" variant="outline" label="Все посты" labelKey="posts.all" />

	<main class="mx-auto w-full max-w-3xl min-w-0">
		<article class="flex w-full min-w-0 flex-col gap-6">
			<PostHeader
				title={data.title}
				description={data.description}
				author={data.author}
				category={data.category}
				pubDate={data.pubDate}
				fullDate={fullDate}
			/>

			<div
				class="prose prose-sm min-w-0 max-w-none sm:prose-base prose-a:font-medium prose-a:text-link prose-a:decoration-link-decoration prose-a:underline-offset-4"
			>
				<Content components={{ ...markdownComponents, h1: SkipNode }} />
			</div>

			<PostTags tags={data.tags} />

			<ContentDates
				publishedDate={publishedDate}
				modifiedDate={modifiedDate}
				class="text-[0.72rem] text-muted-foreground"
			/>
		</article>

		<PostNeighbours newerPost={newerPost} olderPost={olderPost} />
	</main>
</Layout>
