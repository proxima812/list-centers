---
import BackButton from "@/components/navigation/BackButton.astro";
import PostCard from "@/components/posts/PostCard.astro";
import { byNewest, localizedPosts } from "@/domain/post/collection";
import { defaultLocale, getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { formatContentDateTime, getContentDates } from "@/utils/contentDates";
import { getPostId, getPostPath } from "@/utils/posts";
import { render } from "astro:content";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const isDefault = locale === defaultLocale;

const rendered = byNewest(await localizedPosts(locale));

const title = t("posts.title");
const description = t("posts.description");

const fullDateFormatter = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "short",
	year: "numeric",
});

const stripMarkdown = (value: string) =>
	value
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`([^`]+)`/g, "$1")
		.replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
		.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
		.replace(/[#>*_~|-]/g, "")
		.replace(/\s+/g, " ")
		.trim();

const getRelativeTime = (date: Date) => {
	const diffMs = Date.now() - date.getTime();
	const minute = 60000;
	const hour = 60 * minute;
	const day = 24 * hour;

	if (diffMs < hour) {
		return t("posts.ago.minutes", { value: Math.max(1, Math.floor(diffMs / minute)) });
	}

	if (diffMs < day) {
		return t("posts.ago.hours", { value: Math.floor(diffMs / hour) });
	}

	return t("posts.ago.days", { value: Math.floor(diffMs / day) });
};

const postsFeed = await Promise.all(
	rendered.map(async (post) => {
		const { Content } = await render(post);
		const plainText = stripMarkdown(post.body ?? post.data.description);
		const { publishedDate, modifiedDate } = getContentDates({
			pubDate: post.data.pubDate,
			filePath: post.filePath,
		});

		return {
			Content,
			id: getPostId(post.id),
			href: getPostPath(post.id),
			title: post.data.title,
			description: post.data.description,
			author: post.data.author,
			isLong: plainText.length > 200,
			pubDate: post.data.pubDate,
			publishedDate,
			modifiedDate,
			relativeTime: getRelativeTime(post.data.pubDate),
			fullDate: fullDateFormatter.format(post.data.pubDate).replace(/\s?г\.$/, ""),
			publishedLabel: formatContentDateTime(publishedDate, locale),
			modifiedLabel: formatContentDateTime(modifiedDate, locale),
		};
	}),
);

const latestModifiedDate = postsFeed
	.map((post) => post.modifiedDate)
	.filter((date): date is Date => Boolean(date))
	.sort((a, b) => b.getTime() - a.getTime())[0];
---

<Layout
	title={title}
	description={description}
	keywords={["tatarverse", title, "сабантуй", "культура", "язык"]}
	rssURL={isDefault ? "/posts/rss.xml" : undefined}
	markdownURL={isDefault ? "/posts.md" : undefined}
	dateModified={latestModifiedDate}
>
	<BackButton href="/" variant="outline" label="Назад" labelKey="nav.back" />
	<main class="mx-auto w-full max-w-3xl">
		<header class="space-y-3">
			<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{title}
			</h1>
			<p class="max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
				{description}
			</p>
		</header>

		<section class="mt-6 grid gap-4 sm:mt-8 sm:gap-5" aria-label={t("posts.feed")}>
			{
				postsFeed.map((post) => (
					<PostCard
						id={post.id}
						href={post.href}
						title={post.title}
						description={post.description}
						author={post.author}
						pubDate={post.pubDate}
						publishedDate={post.publishedDate}
						modifiedDate={post.modifiedDate}
						relativeTime={post.relativeTime}
						fullDate={post.fullDate}
						publishedLabel={post.publishedLabel}
						modifiedLabel={post.modifiedLabel}
						isLong={post.isLong}
					>
						<post.Content />
					</PostCard>
				))
			}
		</section>
	</main>
</Layout>
