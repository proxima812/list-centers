---
import BackButton from "@/components/navigation/BackButton.astro";
import PostCard from "@/components/posts/PostCard.astro";
import { defaultLocale, getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { byNewest, localizedPosts } from "@/lib/post/collection";
import { buildPostFeed, latestModifiedDate } from "@/lib/post/feed";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const isDefault = locale === defaultLocale;

const title = t("posts.title");
const description = t("posts.description");

const postsFeed = await buildPostFeed(byNewest(await localizedPosts(locale)), locale, t);
---

<Layout
	title={title}
	description={description}
	keywords={["tatarverse", title, "сабантуй", "культура", "язык"]}
	rssURL={isDefault ? "/posts/rss.xml" : undefined}
	markdownURL={isDefault ? "/posts.md" : undefined}
	dateModified={latestModifiedDate(postsFeed)}
>
	<BackButton href="/" variant="outline" label="Назад" labelKey="nav.back" />
	<main class="mx-auto w-full max-w-3xl">
		<header class="space-y-3">
			<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{title}
			</h1>
			<p class="max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
				{description}
			</p>
		</header>

		<section class="mt-6 grid gap-4 sm:mt-8 sm:gap-5" aria-label={t("posts.feed")}>
			{
				postsFeed.map((post) => (
					<PostCard
						id={post.id}
						href={post.href}
						title={post.title}
						description={post.description}
						author={post.author}
						pubDate={post.pubDate}
						publishedDate={post.publishedDate}
						modifiedDate={post.modifiedDate}
						relativeTime={post.relativeTime}
						fullDate={post.fullDate}
						publishedLabel={post.publishedLabel}
						modifiedLabel={post.modifiedLabel}
						isLong={post.isLong}
					>
						<post.Content />
					</PostCard>
				))
			}
		</section>
	</main>
</Layout>
