---
import StatsHero from "@/components/stats/StatsHero.astro";
import StatsMacroGroup from "@/components/stats/StatsMacroGroup.astro";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { countMissingCountries, groupCountriesByMacroRegion } from "@/lib/center/geography";
import { getCenterKindBreakdown } from "@/lib/center/kinds";
import { catalogStats, withoutCountry } from "@/lib/center/stats";
import { getCollection } from "astro:content";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const centers = await getCollection("centers");
const seoStats = catalogStats(centers);
const missingCountry = withoutCountry(centers);
const groups = groupCountriesByMacroRegion(centers, locale);
const missingTotal = countMissingCountries(groups);
const centersHref = localizePath(locale, "/centers");
---

<Layout
	title={t("stats.title")}
	description={t("stats.description", seoStats)}
	keywords={[
		"статистика ТБК",
		"татарские центры по странам",
		`центров: ${centers.length}`,
		`стран: ${seoStats.countries}`,
		`регионов: ${seoStats.regions}`,
		"где нет татарских центров",
		"география татарской диаспоры",
	]}
>
	<StatsHero stats={seoStats} buckets={getCenterKindBreakdown(centers)} />

	<section class="mx-auto max-w-4xl px-6 pb-16 sm:px-12">
		<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
			{t("stats.byCountry")}
		</h2>
		<p class="mt-2 text-sm leading-6 text-muted-foreground">
			{t("stats.byCountry.hint")}
			{
				missingCountry > 0 && (
					<>
						{" "}
						{t("stats.withoutCountry", { count: missingCountry })}
					</>
				)
			}
		</p>

		<div class="mt-10 space-y-12">
			{groups.map((group) => <StatsMacroGroup group={group} catalogHref={centersHref} />)}
		</div>

		<p class="mt-12 border-t border-border pt-6 text-sm leading-6 text-muted-foreground">
			{t("stats.missingNote", { count: missingTotal })}
		</p>
	</section>
</Layout>
