---
import CatalogStats from "@/components/centers/CatalogStats.astro";
import { MACRO_REGIONS, getMacroRegion, type MacroRegion } from "@/data/geo";
import { countryFlagsByRu, getCountryLabel, worldCountriesRu } from "@/data/worldCountries";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCenterKindBreakdown } from "@/utils/centerKinds";
import { getCollection } from "astro:content";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// География каталога живёт только в русской коллекции — переводы её не
// формируют (см. комментарий в src/content.config.ts). Поэтому и счётчики,
// и разбивка по странам считаются здесь, а локализуются только подписи.
const centers = await getCollection("centers");

const countByCountry = new Map<string, number>();
for (const center of centers) {
	const country = center.data.location?.country;
	if (!country) continue;
	countByCountry.set(country, (countByCountry.get(country) ?? 0) + 1);
}

const regionsCount = new Set(
	centers.map((center) => center.data.location?.region).filter(Boolean),
).size;
const withoutCountry = centers.filter((center) => !center.data.location?.country).length;

const seoStats = {
	count: centers.length,
	countries: countByCountry.size,
	regions: regionsCount,
};

interface CountryRow {
	country: string;
	label: string;
	flag: string;
	count: number;
}

const toRow = (country: string): CountryRow => ({
	country,
	label: getCountryLabel(country, locale),
	flag: countryFlagsByRu[country] ?? "",
	count: countByCountry.get(country) ?? 0,
});

// Страна из карточки может не значиться в справочнике `worldCountriesRu`
// (схема требует только макрорегион), поэтому источник списка — сам каталог,
// а справочник добавляет к нему нули.
const knownCountries = new Set([...countByCountry.keys(), ...worldCountriesRu]);

const groups = MACRO_REGIONS.map((macro: MacroRegion) => {
	const inMacro = [...knownCountries].filter((country) => getMacroRegion(country) === macro);
	const present = inMacro
		.filter((country) => countByCountry.has(country))
		.map(toRow)
		.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, locale));
	const missing = inMacro
		.filter((country) => !countByCountry.has(country))
		.map(toRow)
		.sort((a, b) => a.label.localeCompare(b.label, locale));

	return {
		macro,
		label: t(`macro.${macro}`),
		present,
		missing,
		total: present.reduce((sum, row) => sum + row.count, 0),
	};
}).filter((group) => group.present.length > 0 || group.missing.length > 0);

const missingTotal = groups.reduce((sum, group) => sum + group.missing.length, 0);
const kindBreakdown = getCenterKindBreakdown(centers);
const centersHref = localizePath(locale, "/centers");
---

<Layout
	title={t("stats.title")}
	description={t("stats.description", seoStats)}
	keywords={[
		"статистика ТБК",
		"татарские центры по странам",
		`центров: ${centers.length}`,
		`стран: ${countByCountry.size}`,
		`регионов: ${regionsCount}`,
		"где нет татарских центров",
		"география татарской диаспоры",
	]}
>
	<section class="not-container pt-8 pb-10 lg:pt-12">
		<div class="mx-auto max-w-7xl min-w-0 px-6 sm:px-12">
			<div class="mx-auto flex min-w-0 max-w-5xl flex-col items-center space-y-6 text-center">
				<h1
					class="max-w-4xl text-3xl font-bold tracking-[-0.03em] text-foreground sm:text-5xl sm:tracking-[-0.035em] lg:text-6xl"
				>
					{t("stats.title")}
				</h1>
				<p class="max-w-3xl text-base leading-7 text-muted-foreground sm:text-lg">
					{t("stats.intro")}
				</p>
				<CatalogStats
					count={seoStats.count}
					countries={seoStats.countries}
					regions={seoStats.regions}
					buckets={kindBreakdown}
					class="pt-2"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 pb-16 sm:px-12">
		<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
			{t("stats.byCountry")}
		</h2>
		<p class="mt-2 text-sm leading-6 text-muted-foreground">
			{t("stats.byCountry.hint")}
			{
				withoutCountry > 0 && (
					<>
						{" "}
						{t("stats.withoutCountry", { count: withoutCountry })}
					</>
				)
			}
		</p>

		<div class="mt-10 space-y-12">
			{
				groups.map((group) => (
					<section>
						<div class="flex items-baseline justify-between gap-4 border-b border-border pb-2">
							<h3 class="text-base font-bold tracking-tight text-foreground">{group.label}</h3>
							<p class="shrink-0 text-xs font-medium text-muted-foreground">
								{t("stats.groupSummary", {
									countries: group.present.length,
									centers: group.total,
								})}
							</p>
						</div>

						{group.present.length > 0 && (
							<ul class="divide-y divide-border-muted">
								{group.present.map((row) => (
									<li>
										<a
											href={`${centersHref}?country=${encodeURIComponent(row.country)}`}
											class="group -mx-3 flex items-center justify-between gap-4 rounded-micro px-3 py-2.5 text-sm transition hover:bg-muted"
										>
											<span class="flex min-w-0 items-center gap-2">
												<span aria-hidden="true" class="shrink-0">
													{row.flag}
												</span>
												<span class="truncate font-medium text-foreground group-hover:underline group-hover:decoration-link-decoration group-hover:underline-offset-4">
													{row.label}
												</span>
											</span>
											<span class="shrink-0 font-semibold tabular-nums text-foreground">
												{row.count}
											</span>
										</a>
									</li>
								))}
							</ul>
						)}

						{group.missing.length > 0 && (
							<div class="pt-4">
								<p class="text-xs font-medium text-subtle-foreground">
									{t("stats.missingLabel", { count: group.missing.length })}
								</p>
								<p class="mt-1.5 text-sm leading-6 text-muted-foreground">
									{group.missing.map((row, index) => (
										<>
											{index > 0 && <span aria-hidden="true"> · </span>}
											<span class="whitespace-nowrap">
												<span aria-hidden="true">{row.flag}</span> {row.label}
											</span>
										</>
									))}
								</p>
							</div>
						)}
					</section>
				))
			}
		</div>

		<p class="mt-12 border-t border-border pt-6 text-sm leading-6 text-muted-foreground">
			{t("stats.missingNote", { count: missingTotal })}
		</p>
	</section>
</Layout>
