---
// Печатная версия каталога: одна страница, чёрным по белому, без шапки,
// футера, тем и анимаций. Layout сюда намеренно не подключён — он ставит
// на <html> data-theme/data-accent и тянет Header/Footer/BackToTop, а
// печатному листу всё это только мешает. Тёмная тема в проекте включается
// классом `.dark` (см. @custom-variant в tailwind.css), поэтому без скрипта
// Layout страница всегда светлая и токены можно использовать как обычно.
// Акцент (green/blue/violet) здесь не используется сознательно: страница —
// про бумагу, поэтому вся экранная часть тоже монохромная, на нейтральных
// токенах foreground/background/border.
import { config } from "@/config";
import { createCenterRouteIdMap, getCenterPath } from "@/utils/centers";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import "@/styles/tailwind.css";

const centers = await getCollection("centers");
const routeIds = createCenterRouteIdMap(centers);
const siteUrl = config.site.url.replace(/\/$/, "");

const UNKNOWN_COUNTRY = "Прочее";

type PrintEntry = {
	title: string;
	place: string;
	kind: string;
	href: string;
};

const groups = new Map<string, PrintEntry[]>();

for (const center of centers) {
	const country = center.data.location?.country ?? UNKNOWN_COUNTRY;
	// Город и регион часто дублируют друг друга («Казань» / «Казань»),
	// на бумаге такое повторение читается как опечатка.
	const place = [center.data.location?.city, center.data.location?.region]
		.filter(Boolean)
		.filter((value, index, list) => list.indexOf(value) === index)
		.join(", ");
	const kind = [center.data.category, center.data.type].filter(Boolean).join(" · ");

	// Печатается только адрес карточки на сайте, без ссылки на первоисточник:
	// у большинства центров источник — один и тот же каталог конгресса, и на
	// бумаге это 399 повторов одной строки. Карточка ведёт и к контактам,
	// и к самому источнику.
	const entry: PrintEntry = {
		title: center.data.title,
		place,
		kind,
		href: `${siteUrl}${getCenterPath(routeIds.get(center.id) ?? center.id)}`,
	};

	const group = groups.get(country);
	if (group) {
		group.push(entry);
	} else {
		groups.set(country, [entry]);
	}
}

for (const entries of groups.values()) {
	entries.sort((a, b) => a.place.localeCompare(b.place, "ru") || a.title.localeCompare(b.title, "ru"));
}

// Страны по количеству центров: Россия оказывается первой сама собой,
// а страна с двумя карточками не открывает распечатку.
const countries = [...groups.entries()].sort(
	(a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], "ru"),
);

const printedAt = new Date().toLocaleDateString("ru-RU", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<html lang="ru" data-language="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, follow" />
		<title>Список центров для печати — tatarverse</title>
		<link rel="canonical" href={`${siteUrl}/centers`} />
	</head>
	<body class="bg-background font-sans text-foreground">
		<div class="mx-auto max-w-3xl px-6 py-10 print:max-w-none print:px-0 print:py-0">
			<header class="border-b border-border pb-6">
				<h1 class="text-2xl font-bold sm:text-3xl print:text-xl">
					Каталог татарских, башкирских и крымскотатарских центров
				</h1>
				<p class="mt-2 text-base text-muted-foreground print:text-sm">
					Всего центров: {centers.length}. Стран: {countries.length}. Данные на {printedAt}
				</p>
				<p class="mt-1 text-base text-muted-foreground print:text-sm">
					Полный каталог с поиском и картой — {siteUrl}/centers
				</p>
			</header>

			<div
				data-print-toolbar
				class="my-8 space-y-6 rounded-2xl border border-border bg-surface-muted p-5 sm:p-6 print:hidden"
			>
				<section>
					<h2 class="flex items-center gap-2 text-lg font-bold">
						<Icon name="mdi:file-pdf-box" class="size-5 shrink-0" aria-hidden="true" />
						Шаг 1. Выберите страны
					</h2>
					<p class="mt-1 text-base text-muted-foreground">
						Можно отметить несколько. Оставьте «Все страны», чтобы распечатать каталог целиком.
					</p>
					<div
						class="mt-4 flex flex-wrap gap-2"
						role="group"
						aria-label="Фильтр по странам"
						data-print-countries
					>
						<button
							type="button"
							data-print-all
							data-active=""
							aria-pressed="true"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-2 text-base font-medium text-muted-foreground transition hover:bg-muted hover:text-foreground data-[active]:border-foreground data-[active]:bg-foreground data-[active]:text-background"
						>
							<Icon name="mdi:earth" class="size-4 shrink-0" aria-hidden="true" />
							Все страны ({centers.length})
						</button>
						{
							countries.map(([country, entries]) => (
								<button
									type="button"
									data-print-country={country}
									aria-pressed="false"
									class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-2 text-base font-medium text-muted-foreground transition hover:bg-muted hover:text-foreground data-[active]:border-foreground data-[active]:bg-foreground data-[active]:text-background"
								>
									<Icon name="mdi:map-marker-outline" class="size-4 shrink-0" aria-hidden="true" />
									{country} ({entries.length})
								</button>
							))
						}
					</div>
					<p
						class="mt-4 flex items-center gap-2 text-base text-muted-foreground"
						data-print-summary-row
					>
						<Icon name="mdi:format-list-numbered" class="size-4 shrink-0" aria-hidden="true" />
						<span data-print-summary aria-live="polite">
							К печати готово центров: {centers.length}
						</span>
					</p>
				</section>

				<section class="border-t border-border-muted pt-6">
					<h2 class="flex items-center gap-2 text-lg font-bold">
						<Icon name="mdi:printer-outline" class="size-5 shrink-0" aria-hidden="true" />
						Шаг 2. Печать или PDF
					</h2>
					<p class="mt-1 text-base text-muted-foreground">
						В открывшемся окне печати выберите принтер — или пункт «Сохранить как PDF»,
						чтобы получить файл на устройство.
					</p>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<button
							type="button"
							data-print-button
							class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-foreground px-5 py-3 text-base font-semibold text-background transition hover:opacity-85"
						>
							<Icon name="mdi:printer-outline" class="size-5 shrink-0" aria-hidden="true" />
							Открыть окно печати
						</button>
						<a
							href="/centers"
							class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-5 py-3 text-base font-medium text-foreground transition hover:bg-muted"
						>
							<Icon name="mdi:arrow-left" class="size-5 shrink-0" aria-hidden="true" />
							Вернуться к каталогу
						</a>
					</div>
				</section>
			</div>

			<main class="mt-6 print:mt-4">
				{
					countries.map(([country, entries]) => (
						<section data-print-group={country} class="mt-8 first:mt-0 print:mt-6">
							<h2 class="border-b border-border pb-2 text-xl font-bold print:text-base">
								{country} — {entries.length}
							</h2>
							<ol class="mt-3">
								{entries.map((entry, index) => (
									<li class="border-b border-border-muted py-3 print:py-2">
										<p class="text-base font-semibold print:text-sm">
											{index + 1}. {entry.title}
										</p>
										{(entry.place || entry.kind) && (
											<p class="mt-0.5 text-base text-muted-foreground print:text-xs">
												{[entry.place, entry.kind].filter(Boolean).join(" · ")}
											</p>
										)}
										<p class="mt-0.5 text-sm break-all text-muted-foreground print:text-xs">
											{entry.href}
										</p>
									</li>
								))}
							</ol>
						</section>
					))
				}
			</main>

			<footer class="mt-10 border-t border-border pt-4 text-sm text-muted-foreground print:mt-6">
				tatarverse — {siteUrl}
			</footer>
		</div>

		<style is:global>
			@page {
				size: A4;
				margin: 15mm 12mm;
			}

			@media print {
				/* Карточка центра и заголовок страны не должны разрываться между
				   листами: на бумаге такой разрыв читается как две разные записи. */
				li {
					break-inside: avoid;
				}

				h2 {
					break-after: avoid;
				}

				section[data-print-group] {
					break-inside: auto;
				}
			}
		</style>

		<script>
			const printButton = document.querySelector<HTMLButtonElement>("[data-print-button]");
			const allButton = document.querySelector<HTMLButtonElement>("[data-print-all]");
			const countryButtons = Array.from(
				document.querySelectorAll<HTMLButtonElement>("[data-print-country]"),
			);
			const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-print-group]"));
			const summary = document.querySelector<HTMLElement>("[data-print-summary]");

			const selected = new Set<string>();

			function setActive(button: HTMLButtonElement, active: boolean) {
				button.toggleAttribute("data-active", active);
				button.setAttribute("aria-pressed", String(active));
			}

			function render() {
				let visibleCount = 0;

				for (const group of groups) {
					const country = group.dataset.printGroup ?? "";
					const visible = selected.size === 0 || selected.has(country);
					group.hidden = !visible;
					if (visible) {
						visibleCount += group.querySelectorAll("li").length;
					}
				}

				for (const button of countryButtons) {
					setActive(button, selected.has(button.dataset.printCountry ?? ""));
				}

				if (allButton) {
					setActive(allButton, selected.size === 0);
				}

				if (summary) {
					summary.textContent = `К печати готово центров: ${visibleCount}`;
				}
			}

			printButton?.addEventListener("click", () => {
				window.print();
			});

			allButton?.addEventListener("click", () => {
				selected.clear();
				render();
			});

			for (const button of countryButtons) {
				button.addEventListener("click", () => {
					const country = button.dataset.printCountry ?? "";
					if (selected.has(country)) {
						selected.delete(country);
					} else {
						selected.add(country);
					}
					render();
				});
			}

			render();
		</script>
	</body>
</html>
