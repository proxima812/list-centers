---
import PrintList from "@/components/print/PrintList.astro";
import PrintToolbar from "@/components/print/PrintToolbar.astro";
import { config } from "@/config";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import Print from "@/layouts/Print.astro";
import { buildPrintCatalog } from "@/lib/center/print";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const siteUrl = config.site.url.replace(/\/$/, "");
const catalogHref = localizePath(locale, "/centers");
const catalogUrl = `${siteUrl}${catalogHref}`;
const { countries, total } = await buildPrintCatalog(locale, siteUrl);

const printedAt = new Date().toLocaleDateString(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Print title={t("print.title")} canonicalURL={catalogUrl}>
	<header class="border-b border-border pb-6">
		<h1 class="text-2xl font-bold sm:text-3xl print:text-xl">
			{t("print.heading")}
		</h1>
		<p class="mt-2 text-base text-muted-foreground print:text-sm">
			{t("print.stats", { count: total, countries: countries.length, date: printedAt })}
		</p>
		<p class="mt-1 text-base text-muted-foreground print:text-sm">
			{t("print.full", { url: catalogUrl })}
		</p>
	</header>

	<PrintToolbar countries={countries} total={total} catalogHref={catalogHref} />

	<PrintList countries={countries} />

	<footer class="mt-10 border-t border-border pt-4 text-sm text-muted-foreground print:mt-6">
		tatarverse — {siteUrl}
	</footer>
</Print>
