---
import CenterFacts from "@/components/centers/CenterFacts.astro";
import CenterHeader from "@/components/centers/CenterHeader.astro";
import CenterPagination from "@/components/centers/CenterPagination.astro";
import CenterRelated from "@/components/centers/CenterRelated.astro";
import { markdownComponents } from "@/components/markdown/markdownComponents";
import SkipNode from "@/components/markdown/SkipNode.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import ContentDates from "@/components/ui/ContentDates.astro";
import CopyPageMenu from "@/components/ui/CopyPageMenu.astro";
import TranslationFeedbackCard from "@/components/ui/TranslationFeedbackCard.astro";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { collectionFingerprint } from "@/lib/build/cacheKey";
import { createCenterRouteIdMap } from "@/lib/center/centers";
import { buildCenterDetail } from "@/lib/center/detail";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
	const entries = await getCollection("centers");
	const routeIds = createCenterRouteIdMap(entries);

	// Страница центра читает всю коллекцию (похожие, пагинация, EN-версия),
	// поэтому ключ общий: правка любого центра честно инвалидирует все карточки.
	const cacheKey = collectionFingerprint([...entries, ...(await getCollection("centersEn"))]);

	return entries.map((entry) => ({
		params: { id: routeIds.get(entry.id) ?? entry.id },
		props: { entry },
		cacheKey,
	}));
}

interface Props {
	entry: CollectionEntry<"centers">;
	localizedEntry?: CollectionEntry<"centersEn">;
}

const { entry, localizedEntry } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { Content } = await render(localizedEntry ?? entry);
const detail = await buildCenterDetail({ entry, localizedEntry, locale, t });
---

<Layout
	title={detail.title}
	description={detail.description}
	type="article"
	canonicalURL={detail.canonicalURL}
	markdownURL={detail.markdownURL}
	alternates={detail.alternates}
	datePublished={detail.publishedDate}
	dateModified={detail.modifiedDate}
>
	<article class="mx-auto flex w-full max-w-5xl min-w-0 flex-col gap-10">
		<nav class="flex w-full flex-wrap items-center justify-between gap-3">
			<ButtonLink
				href={localizePath(locale, "/centers")}
				labelKey="nav.allCenters"
				variant="outline"
				icon="tabler:arrow-back-up"
			/>
			<CopyPageMenu class="max-w-full justify-self-start sm:justify-self-end" />
		</nav>

		<CenterHeader title={detail.title} summary={detail.summary} badges={detail.badges} />

		<div class="grid min-w-0 grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
			<div class="prose min-w-0 max-w-[68ch]">
				<Content components={{ ...markdownComponents, h1: SkipNode }} />
				<ContentDates
					publishedDate={detail.publishedDate}
					modifiedDate={detail.modifiedDate}
					class="mt-8 text-xs text-subtle-foreground"
				/>
			</div>

			<CenterFacts
				facts={detail.facts}
				sourceUrl={detail.sourceUrl}
				sourceLabel={detail.sourceLabel}
			/>
		</div>

		<CenterRelated
			title={detail.relatedTitle}
			entries={detail.related}
			routeIds={detail.routeIds}
		/>

		<CenterPagination
			previousEntry={detail.previousEntry}
			nextEntry={detail.nextEntry}
			routeIds={detail.routeIds}
		/>

		<TranslationFeedbackCard />
	</article>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(detail.jsonLd)} />
</Layout>
