---
import BackButton from "@/components/navigation/BackButton.astro";
import Layout from "@/layouts/Layout.astro";
import { getProjectAsset, getProjectGradient } from "@/utils/projects";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const title = "Проекты";
const description =
	"Витрина проектов татар, башкир и крымских татар: дело, канал, сайт или сообщество. Размещение бесплатное — это не реклама, а способ помочь своим стать заметнее.";

const feedbackHref = "https://t.me/the_tatarverse/20";
const projects = (await getCollection("projects")).sort(
	(a, b) =>
		a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title, "ru"),
);
const categories = Array.from(new Set(projects.map((project) => project.data.category)));
const categoryCounts = new Map(
	categories.map((category) => [
		category,
		projects.filter((project) => project.data.category === category).length,
	]),
);

const projectCards = projects.map((project) => ({
	entry: project,
	detailHref: `/projects/${project.id}/`,
	logo: getProjectAsset(project.data.logo),
	// Одна строка мета вместо двух чипов: в узкой колонке 4-колоночной сетки
	// категория и город читаются лучше как текст, чем как отдельные плашки.
	meta: [project.data.category, project.data.location].filter(Boolean).join(" · "),
}));
---

<Layout
	title={title}
	description={description}
	keywords={[
		"tatarverse",
		"поддержка",
		"проекты",
		"бизнес",
		"татары",
		"башкиры",
		"крымские татары",
		"общепит",
		"Burger Point",
	]}
>
	<BackButton href="/" variant="outline" label="Назад" labelKey="nav.back" />
	<main class="flex flex-col items-center">
		<header class="flex flex-col items-center text-center">
			<h1 class="text-5xl font-black tracking-tighter text-foreground sm:text-6xl">
				{title}
			</h1>

			<p class="mt-3 max-w-prose text-base font-medium text-muted-foreground sm:text-lg">
				Проекты <span class="font-bold text-foreground">татар</span>, <span
					class="font-bold text-foreground">башкир</span
				> и <span class="font-bold text-foreground">крымских татар</span> — чтобы о них узнало больше
				людей
			</p>
		</header>

		<article class="mt-12 w-full max-w-xl text-center">
			<h2 class="text-2xl font-extrabold tracking-tight text-balance text-foreground sm:text-3xl">
				Ведёте своё дело или проект?
			</h2>

			<p class="mx-auto mt-3 max-w-prose text-sm font-medium text-muted-foreground sm:text-base">
				Бизнес, канал, сайт или сообщество — разместим ссылку и описание, чтобы вас нашли.
				<span class="font-semibold text-foreground">Бесплатно.</span>
			</p>

			<a
				href={feedbackHref}
				target="_blank"
				rel="noreferrer noopener"
				class="group corner-squircle mt-6 inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-bold tracking-tight text-background no-underline transition hover:opacity-90"
			>
				Предложить проект
				<svg
					class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
					viewBox="0 0 16 16"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M3 8h10m0 0-4-4m4 4-4 4"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</article>
	</main>

	<section class="mx-auto mt-14 w-full space-y-6" aria-label="Проекты сообщества">
		<div
			id="project-filter"
			class="flex flex-wrap gap-2"
			role="radiogroup"
			aria-label="Фильтр проектов по категории"
		>
			<button
				type="button"
				role="radio"
				class="filter-btn corner-squircle inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold ring ring-inset transition bg-primary text-primary-foreground ring-primary"
				data-category=""
				aria-checked="true"
				tabindex="0"
			>
				Все
				<span class="text-xs font-bold opacity-60">{projects.length}</span>
			</button>
			{
				categories.map((category) => (
					<button
						type="button"
						role="radio"
						class="filter-btn corner-squircle inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold ring ring-inset transition bg-surface text-muted-foreground ring-border-muted hover:bg-primary/5"
						data-category={category}
						aria-checked="false"
						tabindex="-1"
					>
						{category}
						<span class="text-xs font-bold opacity-60">{categoryCounts.get(category)}</span>
					</button>
				))
			}
		</div>

		<div
			id="project-grid"
			class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
		>
			{
				projectCards.map(({ entry: project, detailHref, logo, meta }) => (
					<a
						href={detailHref}
						class="project-card corner-squircle group flex h-full flex-col gap-3 rounded-card bg-surface p-4 text-surface-foreground no-underline shadow-2xs ring ring-border-muted transition hover:bg-primary/5 hover:ring-primary/30"
						data-category={project.data.category}
					>
						{logo ? (
							<Image
								src={logo}
								alt=""
								class="size-11 shrink-0 rounded-control bg-white object-contain p-1 ring ring-border-muted"
								widths={[44, 88]}
								sizes="2.75rem"
								loading="lazy"
							/>
						) : (
							<div
								class="size-11 shrink-0 rounded-control ring ring-inset ring-white/15"
								style={`background:${getProjectGradient(project.data.title)}`}
								aria-hidden="true"
							/>
						)}

						<div class="min-w-0">
							<h3 class="text-base font-bold leading-snug tracking-tight text-balance">
								{project.data.title}
							</h3>
							<p class="mt-1.5 line-clamp-3 text-xs leading-relaxed font-normal text-muted-foreground">
								{project.data.description}
							</p>
						</div>

						<div class="mt-auto flex items-end justify-between gap-2 pt-1">
							<span class="min-w-0 text-xs font-medium text-subtle-foreground">{meta}</span>
							<Icon
								name="mdi:arrow-right"
								class="size-4 shrink-0 text-subtle-foreground transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary"
								aria-hidden="true"
							/>
						</div>
					</a>
				))
			}
		</div>

		<div id="project-empty" class="hidden py-12 text-center">
			<Icon
				name="mdi:folder-open-outline"
				class="mx-auto size-8 text-subtle-foreground"
				aria-hidden="true"
			/>
			<p class="mt-3 text-sm font-medium text-muted-foreground">
				В этой категории проектов пока нет.
			</p>
		</div>
	</section>

	<script>
		const filter = document.getElementById("project-filter");
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));
		const cards = Array.from(document.querySelectorAll<HTMLElement>(".project-card"));
		const empty = document.getElementById("project-empty");

		// Одна активная категория: "" — показать все. Повторный клик по активной
		// кнопке ничего не сбрасывает, сброс — только через «Все».
		let selected = "";

		const activeOn = ["bg-primary", "text-primary-foreground", "ring-primary"];
		const activeOff = [
			"bg-surface",
			"text-muted-foreground",
			"ring-border-muted",
			"hover:bg-primary/5",
		];

		function setActive(button: HTMLButtonElement, active: boolean) {
			button.setAttribute("aria-checked", String(active));
			// Радиогруппа: в таб-порядке только активная кнопка, внутри — стрелками.
			button.tabIndex = active ? 0 : -1;
			button.classList.remove(...(active ? activeOff : activeOn));
			button.classList.add(...(active ? activeOn : activeOff));
		}

		function render() {
			for (const button of buttons) {
				setActive(button, (button.dataset.category ?? "") === selected);
			}

			let visible = 0;
			for (const card of cards) {
				const show = selected === "" || (card.dataset.category ?? "") === selected;
				card.classList.toggle("hidden", !show);
				if (show) visible++;
			}

			empty?.classList.toggle("hidden", visible > 0);
		}

		function select(category: string, focus = false) {
			selected = category;
			render();

			if (focus) {
				buttons.find((button) => (button.dataset.category ?? "") === category)?.focus();
			}
		}

		filter?.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
			if (!button) return;

			select(button.dataset.category ?? "");
		});

		filter?.addEventListener("keydown", (event) => {
			const keys = ["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"];
			if (!keys.includes(event.key)) return;

			const current = buttons.findIndex((button) => (button.dataset.category ?? "") === selected);
			if (current === -1) return;

			event.preventDefault();

			const forward = event.key === "ArrowRight" || event.key === "ArrowDown";
			let next = current;

			if (event.key === "Home") next = 0;
			else if (event.key === "End") next = buttons.length - 1;
			else next = (current + (forward ? 1 : -1) + buttons.length) % buttons.length;

			select(buttons[next].dataset.category ?? "", true);
		});

		render();
	</script>
</Layout>
