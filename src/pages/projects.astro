---
import BackButton from "@/components/navigation/BackButton.astro";
import Layout from "@/layouts/Layout.astro";
import { getProjectAsset, getProjectGradient } from "@/utils/projects";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const title = "Проекты";
const description =
	"Поддержка в tatarverse: витрина проектов татар, башкир и крымских татар — малый и средний бизнес, YouTube-каналы, сайты, Telegram-каналы и другие соцсети. Расскажите о своём проекте, чтобы его заметили.";

const feedbackHref = "https://t.me/the_tatarverse/20";
const projects = (await getCollection("projects")).sort(
	(a, b) =>
		a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title, "ru"),
);
const categories = Array.from(new Set(projects.map((project) => project.data.category)));
const categoryCounts = new Map(
	categories.map((category) => [
		category,
		projects.filter((project) => project.data.category === category).length,
	]),
);

function getUrlLabel(url?: string) {
	if (!url) return null;

	try {
		return new URL(url).hostname.replace(/^www\./, "");
	} catch {
		return url;
	}
}

// Цветные акценты — только в иконках: палитра сайта монохромная,
// цвет здесь работает как маркер типа проекта, а не как второй бренд-цвет.
// Ступень 600, а не 500: на 500 amber давал 2.04:1 к светлой странице, sky —
// 2.63:1, то есть ниже порога 3:1 для нетекстовых элементов. 600 проходит и на
// светлой (3.03-3.89), и на самой светлой тёмной «бумаге» (4.16-5.35), поэтому
// пара dark: здесь не нужна.
// Telegram — sky (его бренд-голубой), не violet: фиолетовая иконка при
// фиолетовом пресете акцента читалась бы как акцентный элемент.
const pitchItems = [
	{ icon: "mdi:storefront-outline", title: "Небольшой бизнес", tone: "text-amber-600" },
	{ icon: "mdi:youtube", title: "YouTube-канал", tone: "text-rose-500" },
	{ icon: "mdi:web", title: "Сайт", tone: "text-sky-600" },
	{ icon: "mdi:telegram", title: "Telegram и соцсети", tone: "text-sky-600" },
] as const;

const projectCards = projects.map((project) => ({
	entry: project,
	detailHref: `/projects/${project.id}/`,
	logo: getProjectAsset(project.data.logo),
	websiteLabel: getUrlLabel(project.data.website),
}));
---

<Layout
	title={title}
	description={description}
	keywords={[
		"tatarverse",
		"поддержка",
		"проекты",
		"бизнес",
		"татары",
		"башкиры",
		"крымские татары",
		"общепит",
		"Burger Point",
	]}
>
	<BackButton href="/" variant="outline" label="Назад" labelKey="nav.back" />
	<main class="flex flex-col items-center">
		<header class="flex flex-col items-center text-center">
			<h1 class="text-5xl font-black tracking-tighter text-foreground sm:text-6xl">
				{title}
			</h1>

			<p class="mt-3 max-w-prose text-base font-medium text-muted-foreground sm:text-lg">
				Проекты <span class="font-bold text-foreground">татар</span>, <span
					class="font-bold text-foreground">башкир</span
				> и <span class="font-bold text-foreground">крымских татар</span>
			</p>
		</header>

		<article class="mt-12 w-full max-w-2xl text-center">
			<h2 class="text-2xl font-extrabold tracking-tight text-balance text-foreground sm:text-3xl">
				Ведёте своё дело или проект?
			</h2>

			<ul class="mt-8 flex flex-wrap justify-center gap-x-7 gap-y-4">
				{
					pitchItems.map((item) => (
						<li class="inline-flex items-center gap-2">
							<Icon name={item.icon} class:list={["size-5 shrink-0", item.tone]} aria-hidden="true" />
							<span class="text-sm font-semibold text-foreground sm:text-base">{item.title}</span>
						</li>
					))
				}
			</ul>

			<p
				class="mx-auto mt-8 max-w-prose text-sm leading-relaxed font-normal text-muted-foreground sm:text-base"
			>
				Мы разместим ссылку и описание, чтобы земляки и гости смогли вас найти и поддержать: <span
					class="font-semibold text-foreground">подписаться</span
				>, <span class="font-semibold text-foreground">заказать</span>, <span
					class="font-semibold text-foreground">рассказать друзьям</span
				>.
			</p>

			<a
				href={feedbackHref}
				target="_blank"
				rel="noreferrer noopener"
				class="group corner-squircle mt-8 inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-bold tracking-tight text-background no-underline transition hover:opacity-90"
			>
				Предложить проект
				<svg
					class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
					viewBox="0 0 16 16"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M3 8h10m0 0-4-4m4 4-4 4"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</article>
	</main>

	<section class="mx-auto mt-14 w-full space-y-6" aria-label="Проекты сообщества">
		<div
			id="project-filter"
			class="flex flex-wrap gap-2"
			role="radiogroup"
			aria-label="Фильтр проектов по категории"
		>
			<button
				type="button"
				role="radio"
				class="filter-btn corner-squircle inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold ring ring-inset transition bg-primary text-primary-foreground ring-primary"
				data-category=""
				aria-checked="true"
				tabindex="0"
			>
				Все
				<span class="text-xs font-bold opacity-60">{projects.length}</span>
			</button>
			{
				categories.map((category) => (
					<button
						type="button"
						role="radio"
						class="filter-btn corner-squircle inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold ring ring-inset transition bg-surface text-muted-foreground ring-border-muted hover:bg-primary/5"
						data-category={category}
						aria-checked="false"
						tabindex="-1"
					>
						{category}
						<span class="text-xs font-bold opacity-60">{categoryCounts.get(category)}</span>
					</button>
				))
			}
		</div>

		<div id="project-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2">
			{
				projectCards.map(({ entry: project, detailHref, logo, websiteLabel }) => (
					<article
						class="project-card corner-squircle relative flex h-full flex-col gap-4 rounded-catalog bg-surface p-5 text-surface-foreground shadow-2xs ring ring-border-muted transition hover:bg-primary/5 hover:ring-primary/30 sm:p-6"
						data-category={project.data.category}
					>
						<a
							href={detailHref}
							class="absolute inset-0 z-0 rounded-catalog corner-squircle"
							aria-label={project.data.title}
						>
							<span class="sr-only">{project.data.title}</span>
						</a>
						<div class="pointer-events-none relative z-10 flex min-w-0 items-start gap-4">
							{logo ? (
								<Image
									src={logo}
									alt={`Логотип ${project.data.title}`}
									class="size-16 shrink-0 rounded-control bg-white object-contain p-1 ring ring-border-muted"
									widths={[64, 128]}
									sizes="4rem"
									loading="lazy"
								/>
							) : (
								<div
									class="size-16 shrink-0 rounded-control ring ring-inset ring-white/15"
									style={`background:${getProjectGradient(project.data.title)}`}
									aria-hidden="true"
								/>
							)}
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center gap-2">
									<span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold tracking-wide text-primary uppercase ring ring-inset ring-primary/10">
										{project.data.category}
									</span>
									{project.data.location ? (
										<span class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground">
											<Icon
												name="mdi:map-marker-outline"
												class="size-4 text-subtle-foreground"
												aria-hidden="true"
											/>
											{project.data.location}
										</span>
									) : null}
								</div>
								<h3 class="mt-2 text-xl font-extrabold tracking-tight text-balance">
									{project.data.title}
								</h3>
								{project.data.website && websiteLabel ? (
									<a
										href={project.data.website}
										target="_blank"
										rel="noreferrer noopener"
										class="pointer-events-auto relative mt-1 inline-flex max-w-full items-center gap-1.5 text-sm font-medium text-link underline decoration-link-decoration underline-offset-4"
									>
										<Icon
											name="mdi:link-variant"
											class="size-4 shrink-0 no-underline"
											aria-hidden="true"
										/>
										<span class="truncate">{websiteLabel}</span>
									</a>
								) : null}
							</div>
						</div>

						<div class="relative z-10 mt-auto flex flex-wrap gap-2">
							<a
								href={detailHref}
								class="group/btn inline-flex items-center gap-2 rounded-control corner-squircle bg-primary px-4 py-2 text-sm font-bold tracking-tight text-primary-foreground no-underline transition hover:bg-primary/80"
							>
								Подробнее
								<Icon
									name="mdi:arrow-right"
									class="size-4 transition-transform duration-200 group-hover/btn:translate-x-0.5"
									aria-hidden="true"
								/>
							</a>
							{project.data.instagram ? (
								<a
									href={project.data.instagram}
									target="_blank"
									rel="noreferrer noopener"
									class="inline-flex items-center gap-2 rounded-control corner-squircle bg-transparent px-4 py-2 text-sm font-semibold text-primary/80 no-underline ring ring-inset ring-primary/10 transition hover:bg-rose-500/5 hover:text-rose-600 hover:ring-rose-500/20"
								>
									<Icon name="mdi:instagram" class="size-4 text-rose-500" aria-hidden="true" />
									Instagram
								</a>
							) : null}
						</div>
					</article>
				))
			}
		</div>

		<div id="project-empty" class="hidden py-12 text-center">
			<Icon
				name="mdi:folder-open-outline"
				class="mx-auto size-8 text-subtle-foreground"
				aria-hidden="true"
			/>
			<p class="mt-3 text-sm font-medium text-muted-foreground">
				В этой категории проектов пока нет.
			</p>
		</div>
	</section>

	<script>
		const filter = document.getElementById("project-filter");
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));
		const cards = Array.from(document.querySelectorAll<HTMLElement>(".project-card"));
		const empty = document.getElementById("project-empty");

		// Одна активная категория: "" — показать все. Повторный клик по активной
		// кнопке ничего не сбрасывает, сброс — только через «Все».
		let selected = "";

		const activeOn = ["bg-primary", "text-primary-foreground", "ring-primary"];
		const activeOff = [
			"bg-surface",
			"text-muted-foreground",
			"ring-border-muted",
			"hover:bg-primary/5",
		];

		function setActive(button: HTMLButtonElement, active: boolean) {
			button.setAttribute("aria-checked", String(active));
			// Радиогруппа: в таб-порядке только активная кнопка, внутри — стрелками.
			button.tabIndex = active ? 0 : -1;
			button.classList.remove(...(active ? activeOff : activeOn));
			button.classList.add(...(active ? activeOn : activeOff));
		}

		function render() {
			for (const button of buttons) {
				setActive(button, (button.dataset.category ?? "") === selected);
			}

			let visible = 0;
			for (const card of cards) {
				const show = selected === "" || (card.dataset.category ?? "") === selected;
				card.classList.toggle("hidden", !show);
				if (show) visible++;
			}

			empty?.classList.toggle("hidden", visible > 0);
		}

		function select(category: string, focus = false) {
			selected = category;
			render();

			if (focus) {
				buttons.find((button) => (button.dataset.category ?? "") === category)?.focus();
			}
		}

		filter?.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
			if (!button) return;

			select(button.dataset.category ?? "");
		});

		filter?.addEventListener("keydown", (event) => {
			const keys = ["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"];
			if (!keys.includes(event.key)) return;

			const current = buttons.findIndex((button) => (button.dataset.category ?? "") === selected);
			if (current === -1) return;

			event.preventDefault();

			const forward = event.key === "ArrowRight" || event.key === "ArrowDown";
			let next = current;

			if (event.key === "Home") next = 0;
			else if (event.key === "End") next = buttons.length - 1;
			else next = (current + (forward ? 1 : -1) + buttons.length) % buttons.length;

			select(buttons[next].dataset.category ?? "", true);
		});

		render();
	</script>
</Layout>
