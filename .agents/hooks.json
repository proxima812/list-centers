{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "Loading project guardrails"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/pre_tool_use_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking project edit guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/posts_style_check.py\"",
            "timeout": 10,
            "statusMessage": "Checking post style rules"
          }
        ]
      }
    ]
  }
}
